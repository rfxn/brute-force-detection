INSTALL_PATH="${INSTALL_PATH:-/usr/local/bfd}"

if [ ! -d "$INSTALL_PATH.bk.last" ]; then
	exit 0
fi

old_conf="$INSTALL_PATH.bk.last/conf.bfd"
new_conf="$INSTALL_PATH/conf.bfd"

if [ ! -f "$old_conf" ] || [ ! -f "$new_conf" ]; then
	exit 0
fi

# extract old/new version from file header comment
OV=$(awk '/^# Brute Force Detection/ {print $5; exit}' "$old_conf")
NV=$(awk '/^# Brute Force Detection/ {print $5; exit}' "$new_conf")

# merge_conf old_source new_target — overlay old user values onto new config
# awk extracts raw text (no shell expansion), preserving $ATTACK_HOST etc.
merge_conf() {
	local old_source="$1" new_target="$2"
	awk -v old_conf="$old_source" '
BEGIN {
	# read old config: store last uncommented assignment per variable
	while ((getline line < old_conf) > 0) {
		if (line ~ /^[A-Za-z_][A-Za-z_0-9]*=/) {
			idx = index(line, "=")
			name = substr(line, 1, idx - 1)
			old[name] = line
		}
	}
	close(old_conf)
}
{
	# for uncommented assignments in new config, substitute old value if exists
	if ($0 ~ /^[A-Za-z_][A-Za-z_0-9]*=/) {
		idx = index($0, "=")
		name = substr($0, 1, idx - 1)
		if (name in old) {
			print old[name]
			next
		}
	}
	print
}' "$new_target" > "$new_target.tmp" && mv -f "$new_target.tmp" "$new_target"
}

# build combined old source: concatenate old conf.bfd + old internals.conf
# (for pre-split installs, all variables are in conf.bfd; for post-split,
# internals.conf has the internal variables)
old_combined=$(mktemp "$INSTALL_PATH/tmp/.importconf.XXXXXX")
trap 'rm -f "$old_combined" "$INSTALL_PATH/conf.bfd.tmp" "$INSTALL_PATH/internals.conf.tmp" "$INSTALL_PATH/thresholds.conf.tmp" "$INSTALL_PATH/pressure.conf.tmp"' EXIT INT TERM
cat "$old_conf" > "$old_combined"
if [ -f "$INSTALL_PATH.bk.last/internals.conf" ]; then
	cat "$INSTALL_PATH.bk.last/internals.conf" >> "$old_combined"
fi

# merge conf.bfd
merge_conf "$old_combined" "$new_conf"

# merge internals.conf if new install has it
new_int="$INSTALL_PATH/internals.conf"
if [ -f "$new_int" ]; then
	merge_conf "$old_combined" "$new_int"
fi

rm -f "$old_combined"

# Migrate old variable names → new pressure model names in conf.bfd
# Only if old config used legacy names (TRIG, BAN_DURATION, etc.)
_pressure_migrated=0
if grep -q '^TRIG=' "$old_conf" 2>/dev/null && ! grep -q '^PRESSURE_TRIP=' "$old_conf" 2>/dev/null; then
	# map old → new variable names in the merged conf.bfd
	_old_val=$(awk -F= '/^TRIG=/{gsub(/"/, "", $2); print $2; exit}' "$old_conf")
	if [ -n "$_old_val" ] && [[ "$_old_val" =~ ^[0-9]+$ ]]; then
		sed -i "s|^PRESSURE_TRIP=.*|PRESSURE_TRIP=\"${_old_val}\"|" "$new_conf"
		_pressure_migrated=1
	fi
fi
if grep -q '^TRIG_WINDOW=' "$old_conf" 2>/dev/null && ! grep -q '^PRESSURE_HALF_LIFE=' "$old_conf" 2>/dev/null; then
	_old_val=$(awk -F= '/^TRIG_WINDOW=/{gsub(/"/, "", $2); print $2; exit}' "$old_conf")
	if [ -n "$_old_val" ] && [[ "$_old_val" =~ ^[0-9]+$ ]]; then
		sed -i "s|^PRESSURE_HALF_LIFE=.*|PRESSURE_HALF_LIFE=\"${_old_val}\"|" "$new_conf"
		_pressure_migrated=1
	fi
fi
if grep -q '^TRIG_GLOBAL=' "$old_conf" 2>/dev/null && ! grep -q '^PRESSURE_TRIP_GLOBAL=' "$old_conf" 2>/dev/null; then
	_old_val=$(awk -F= '/^TRIG_GLOBAL=/{gsub(/"/, "", $2); print $2; exit}' "$old_conf")
	if [ -n "$_old_val" ] && [[ "$_old_val" =~ ^[0-9]+$ ]]; then
		sed -i "s|^PRESSURE_TRIP_GLOBAL=.*|PRESSURE_TRIP_GLOBAL=\"${_old_val}\"|" "$new_conf"
		_pressure_migrated=1
	fi
fi
if grep -q '^BAN_DURATION=' "$old_conf" 2>/dev/null && ! grep -q '^BAN_TTL=' "$old_conf" 2>/dev/null; then
	_old_val=$(awk -F= '/^BAN_DURATION=/{gsub(/"/, "", $2); print $2; exit}' "$old_conf")
	if [ -n "$_old_val" ] && [[ "$_old_val" =~ ^[0-9]+$ ]]; then
		sed -i "s|^BAN_TTL=.*|BAN_TTL=\"${_old_val}\"|" "$new_conf"
		_pressure_migrated=1
	fi
fi
if grep -q '^BAN_PERMANENT_AFTER=' "$old_conf" 2>/dev/null && ! grep -q '^BAN_ESCALATE_AFTER=' "$old_conf" 2>/dev/null; then
	_old_val=$(awk -F= '/^BAN_PERMANENT_AFTER=/{gsub(/"/, "", $2); print $2; exit}' "$old_conf")
	if [ -n "$_old_val" ] && [[ "$_old_val" =~ ^[0-9]+$ ]]; then
		sed -i "s|^BAN_ESCALATE_AFTER=.*|BAN_ESCALATE_AFTER=\"${_old_val}\"|" "$new_conf"
		_pressure_migrated=1
	fi
fi
if grep -q '^BAN_PERMANENT_WINDOW=' "$old_conf" 2>/dev/null && ! grep -q '^BAN_ESCALATE_WINDOW=' "$old_conf" 2>/dev/null; then
	_old_val=$(awk -F= '/^BAN_PERMANENT_WINDOW=/{gsub(/"/, "", $2); print $2; exit}' "$old_conf")
	if [ -n "$_old_val" ] && [[ "$_old_val" =~ ^[0-9]+$ ]]; then
		sed -i "s|^BAN_ESCALATE_WINDOW=.*|BAN_ESCALATE_WINDOW=\"${_old_val}\"|" "$new_conf"
		_pressure_migrated=1
	fi
fi
if [ "$_pressure_migrated" -eq 1 ]; then
	echo "  Migrated legacy config (TRIG/BAN_DURATION) to pressure model (weights=1). Run 'bfd -c' to verify."
fi

# Phase 25: if upgrading from pre-firewall-backend config, set custom mode
# to preserve existing BAN_COMMAND behavior
if ! grep -q '^FIREWALL=' "$old_conf" 2>/dev/null; then
	sed -i 's/^FIREWALL="auto"/FIREWALL="custom"/' "$new_conf"
	echo "  Note: FIREWALL set to 'custom' (preserves existing BAN_COMMAND/UNBAN_COMMAND). Run 'bfd -c' to verify."
fi

# migrate per-rule overrides to pressure.conf
new_press="$INSTALL_PATH/pressure.conf"
if [ -f "$INSTALL_PATH.bk.last/pressure.conf" ]; then
	# already has pressure.conf — preserve it
	cp -f "$INSTALL_PATH.bk.last/pressure.conf" "$new_press"
	echo "  Preserved pressure.conf from previous install."
elif [ -f "$INSTALL_PATH.bk.last/thresholds.conf" ]; then
	# translate thresholds.conf TRIG entries → pressure.conf PRESSURE_TRIP entries
	_migrated=0
	while IFS=: read -r _rule_name _rest; do
		[ -z "$_rule_name" ] && continue
		# skip comments
		case "$_rule_name" in \#*) continue ;; esac
		# extract TRIG value
		_old_trig=$(echo "$_rest" | awk -F: '{for(i=1;i<=NF;i++){if($i ~ /^TRIG=/){sub(/^TRIG=/,"",$i); print $i; exit}}}')
		[[ "$_old_trig" =~ ^[0-9]+$ ]] || _old_trig=""
		if [ -n "$_old_trig" ] && [ -f "$new_press" ]; then
			if grep -q "^${_rule_name}:" "$new_press" 2>/dev/null; then
				# update existing entry — replace or add PRESSURE_TRIP
				if grep -q "^${_rule_name}:.*PRESSURE_TRIP=" "$new_press" 2>/dev/null; then
					sed -i "s|^\(${_rule_name}:.*PRESSURE_TRIP=\)[^:]*|\1${_old_trig}|" "$new_press"
				else
					sed -i "s|^${_rule_name}:\(.*\)|${_rule_name}:\1:PRESSURE_TRIP=${_old_trig}|" "$new_press"
				fi
			else
				echo "${_rule_name}:PRESSURE_TRIP=${_old_trig}" >> "$new_press"
			fi
			_migrated=$((_migrated + 1))
		fi
		# extract SKIP_ALERT value
		_skip=$(echo "$_rest" | awk -F: '{for(i=1;i<=NF;i++){if($i ~ /^SKIP_ALERT=/){sub(/^SKIP_ALERT=/,"",$i); print $i; exit}}}')
		[[ "$_skip" =~ ^[01]$ ]] || _skip=""
		if [ -n "$_skip" ] && [ -f "$new_press" ]; then
			if grep -q "^${_rule_name}:" "$new_press" 2>/dev/null && \
			   ! grep -q "^${_rule_name}:.*SKIP_ALERT=" "$new_press" 2>/dev/null; then
				sed -i "s|^${_rule_name}:\(.*\)|${_rule_name}:\1:SKIP_ALERT=${_skip}|" "$new_press"
			fi
		fi
		# extract RULE_EMAIL value
		_email=$(echo "$_rest" | awk -F: '{for(i=1;i<=NF;i++){if($i ~ /^RULE_EMAIL=/){sub(/^RULE_EMAIL=/,"",$i); print $i; exit}}}')
		[[ "$_email" =~ ^[a-zA-Z0-9@._+,-]+$ ]] || _email=""
		if [ -n "$_email" ] && [ -f "$new_press" ]; then
			if grep -q "^${_rule_name}:" "$new_press" 2>/dev/null && \
			   ! grep -q "^${_rule_name}:.*RULE_EMAIL=" "$new_press" 2>/dev/null; then
				sed -i "s|^${_rule_name}:\(.*\)|${_rule_name}:\1:RULE_EMAIL=${_email}|" "$new_press"
			fi
		fi
	done < "$INSTALL_PATH.bk.last/thresholds.conf"
	if [ "$_migrated" -gt 0 ]; then
		echo "  Migrated $_migrated per-rule thresholds from thresholds.conf to pressure.conf."
	fi
elif [ -f "$new_press" ] && [ -d "$INSTALL_PATH.bk.last/rules" ]; then
	# pre-thresholds upgrade: extract uncommented TRIG/PRESSURE values from old rules
	_migrated=0
	for _rule_file in "$INSTALL_PATH.bk.last/rules"/*; do
		[ ! -f "$_rule_file" ] && continue
		_rule_name=$(basename "$_rule_file")
		_old_trig=$(grep -E '^TRIG="[0-9]+"' "$_rule_file" 2>/dev/null | head -1)
		if [ -n "$_old_trig" ]; then
			_old_trig="${_old_trig#TRIG=\"}"
			_old_trig="${_old_trig%\"}"
			[[ "$_old_trig" =~ ^[0-9]+$ ]] || continue
			if grep -q "^${_rule_name}:" "$new_press" 2>/dev/null; then
				# replace or add PRESSURE_TRIP from old rule TRIG
				if grep -q "^${_rule_name}:.*PRESSURE_TRIP=" "$new_press" 2>/dev/null; then
					sed -i "s|^\(${_rule_name}:.*PRESSURE_TRIP=\)[^:]*|\1${_old_trig}|" "$new_press"
				else
					sed -i "s|^${_rule_name}:\(.*\)|${_rule_name}:\1:PRESSURE_TRIP=${_old_trig}|" "$new_press"
				fi
			else
				echo "${_rule_name}:PRESSURE_TRIP=${_old_trig}" >> "$new_press"
			fi
			_migrated=$((_migrated + 1))
		fi
	done
	if [ "$_migrated" -gt 0 ]; then
		echo "  Migrated $_migrated per-rule thresholds to pressure.conf."
	fi
fi

# preserve user's country pressure multiplier customizations
if [ -f "$INSTALL_PATH.bk.last/pressure-country.conf" ]; then
	cp -f "$INSTALL_PATH.bk.last/pressure-country.conf" "$INSTALL_PATH/pressure-country.conf"
	echo "  Preserved pressure-country.conf from previous install."
fi

# preserve user's ignore lists
cp -f "$INSTALL_PATH.bk.last/ignore.hosts" "$INSTALL_PATH" 2>/dev/null

# preserve ban tracking state
cp -f "$INSTALL_PATH.bk.last/tmp/bans.active" "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/tmp/bans.history"* "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/tmp/events.dat" "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/stats/"* "$INSTALL_PATH/stats/" 2>/dev/null

# preserve journal cursor/timestamp state
cp -f "$INSTALL_PATH.bk.last/tmp/"*.cursor "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/tmp/"*.jts "$INSTALL_PATH/tmp/" 2>/dev/null

# preserve tlog byte-offset tracking state
# (files named by LOG_TAG: sshd, dovecot, postfix, etc. — no dots in name)
for _f in "$INSTALL_PATH.bk.last/tmp/"*; do
	[ -f "$_f" ] || continue
	_bn="${_f##*/}"
	# skip dotfiles, extension files, and already-preserved patterns
	case "$_bn" in
		.*|*.*) continue ;;
	esac
	cp -f "$_f" "$INSTALL_PATH/tmp/" 2>/dev/null
done

# preserve user's custom alert template (install.sh overwrites with new default)
if [ -f "$INSTALL_PATH.bk.last/alert.bfd" ]; then
	cp -f "$INSTALL_PATH.bk.last/alert.bfd" "$INSTALL_PATH/alert.bfd"
fi

# preserve custom rule files from backup (user-added rules not in shipped set)
if [ -d "$INSTALL_PATH.bk.last/rules" ]; then
	_custom_rules=0
	for _old_rule in "$INSTALL_PATH.bk.last/rules"/*; do
		[ -f "$_old_rule" ] || continue
		_rule_name="${_old_rule##*/}"
		# skip rules that exist in the new install (shipped rules — use new version)
		[ -f "$INSTALL_PATH/rules/$_rule_name" ] && continue
		cp -f "$_old_rule" "$INSTALL_PATH/rules/$_rule_name"
		chmod 640 "$INSTALL_PATH/rules/$_rule_name"
		_custom_rules=$((_custom_rules + 1))
	done
	if [ "$_custom_rules" -gt 0 ]; then
		echo "  Restored $_custom_rules custom rule(s) from previous install."
	fi
fi

# preserve user's custom exclude.files entries
if [ -f "$INSTALL_PATH.bk.last/exclude.files" ]; then
	cp -f "$INSTALL_PATH.bk.last/exclude.files" "$INSTALL_PATH/exclude.files"
fi

echo "  Imported config and state from BFD $OV to $NV."
