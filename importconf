INSTALL_PATH="${INSTALL_PATH:-/usr/local/bfd}"

if [ ! -d "$INSTALL_PATH.bk.last" ]; then
	exit 0
fi

old_conf="$INSTALL_PATH.bk.last/conf.bfd"
new_conf="$INSTALL_PATH/conf.bfd"

if [ ! -f "$old_conf" ] || [ ! -f "$new_conf" ]; then
	exit 0
fi

# extract old/new version from file header comment
OV=$(awk '/^# Brute Force Detection/ {print $5; exit}' "$old_conf")
NV=$(awk '/^# Brute Force Detection/ {print $5; exit}' "$new_conf")

# merge_conf old_source new_target — overlay old user values onto new config
# awk extracts raw text (no shell expansion), preserving $ATTACK_HOST etc.
merge_conf() {
	local old_source="$1" new_target="$2"
	awk -v old_conf="$old_source" '
BEGIN {
	# read old config: store last uncommented assignment per variable
	while ((getline line < old_conf) > 0) {
		if (line ~ /^[A-Za-z_][A-Za-z_0-9]*=/) {
			idx = index(line, "=")
			name = substr(line, 1, idx - 1)
			old[name] = line
		}
	}
	close(old_conf)
}
{
	# for uncommented assignments in new config, substitute old value if exists
	if ($0 ~ /^[A-Za-z_][A-Za-z_0-9]*=/) {
		idx = index($0, "=")
		name = substr($0, 1, idx - 1)
		if (name in old) {
			print old[name]
			next
		}
	}
	print
}' "$new_target" > "$new_target.tmp" && mv -f "$new_target.tmp" "$new_target"
}

# build combined old source: concatenate old conf.bfd + old internals.conf
# (for pre-split installs, all variables are in conf.bfd; for post-split,
# internals.conf has the internal variables)
old_combined=$(mktemp "$INSTALL_PATH/tmp/.importconf.XXXXXX")
trap 'rm -f "$old_combined" "$INSTALL_PATH/conf.bfd.tmp" "$INSTALL_PATH/internals.conf.tmp"' EXIT INT TERM
cat "$old_conf" > "$old_combined"
if [ -f "$INSTALL_PATH.bk.last/internals.conf" ]; then
	cat "$INSTALL_PATH.bk.last/internals.conf" >> "$old_combined"
fi

# merge conf.bfd
merge_conf "$old_combined" "$new_conf"

# merge internals.conf if new install has it
new_int="$INSTALL_PATH/internals.conf"
if [ -f "$new_int" ]; then
	merge_conf "$old_combined" "$new_int"
fi

rm -f "$old_combined"

# Phase 25: if upgrading from pre-firewall-backend config, set custom mode
# to preserve existing BAN_COMMAND behavior
if ! grep -q '^FIREWALL=' "$old_conf" 2>/dev/null; then
	sed -i 's/^FIREWALL="auto"/FIREWALL="custom"/' "$new_conf"
	echo "  Note: FIREWALL set to 'custom' (preserves existing BAN_COMMAND behavior)."
fi

# preserve user's ignore lists
cp -f "$INSTALL_PATH.bk.last/ignore.hosts" "$INSTALL_PATH" 2>/dev/null

# preserve ban tracking state
cp -f "$INSTALL_PATH.bk.last/tmp/bans.active" "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/tmp/bans.history"* "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/tmp/events.dat" "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/stats/"* "$INSTALL_PATH/stats/" 2>/dev/null

# preserve journal cursor/timestamp state
cp -f "$INSTALL_PATH.bk.last/tmp/"*.cursor "$INSTALL_PATH/tmp/" 2>/dev/null
cp -f "$INSTALL_PATH.bk.last/tmp/"*.jts "$INSTALL_PATH/tmp/" 2>/dev/null

echo "  Imported config and state from BFD $OV to $NV."
