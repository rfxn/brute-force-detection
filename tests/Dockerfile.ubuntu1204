FROM ubuntu:12.04

# Ubuntu 12.04 (Precise) is EOL — use old-releases repos
RUN sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|; s|security.ubuntu.com|old-releases.ubuntu.com|' /etc/apt/sources.list

RUN apt-get update && apt-get install -y \
    coreutils \
    sed \
    grep \
    mawk \
    gzip \
    util-linux \
    procps \
    iproute \
    hostname \
    wget \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 12.04 wget may not support TLS 1.2+ for GitHub.
# Use curl as primary, wget --no-check-certificate as fallback.
RUN mkdir -p /opt/bats && \
    (curl -sSL -k https://github.com/bats-core/bats-core/archive/refs/tags/v1.11.0.tar.gz || \
     wget --no-check-certificate -qO- https://github.com/bats-core/bats-core/archive/refs/tags/v1.11.0.tar.gz) | \
      tar xz -C /opt/bats --strip-components=1 && \
    /opt/bats/install.sh /usr/local && \
    mkdir -p /usr/local/lib/bats/bats-support && \
    (curl -sSL -k https://github.com/bats-core/bats-support/archive/refs/tags/v0.3.0.tar.gz || \
     wget --no-check-certificate -qO- https://github.com/bats-core/bats-support/archive/refs/tags/v0.3.0.tar.gz) | \
      tar xz -C /usr/local/lib/bats/bats-support --strip-components=1 && \
    mkdir -p /usr/local/lib/bats/bats-assert && \
    (curl -sSL -k https://github.com/bats-core/bats-assert/archive/refs/tags/v2.1.0.tar.gz || \
     wget --no-check-certificate -qO- https://github.com/bats-core/bats-assert/archive/refs/tags/v2.1.0.tar.gz) | \
      tar xz -C /usr/local/lib/bats/bats-assert --strip-components=1

# Copy BFD source and tests
COPY files/ /opt/bfd/files/
COPY importconf /opt/bfd/importconf
COPY bfd-watch.init /opt/bfd/bfd-watch.init
COPY bfd-watch.service /opt/bfd/bfd-watch.service
COPY bfd.service /opt/bfd/bfd.service
COPY cron /opt/bfd/cron
COPY cron.daily /opt/bfd/cron.daily
COPY install.sh /opt/bfd/install.sh
COPY uninstall.sh /opt/bfd/uninstall.sh
COPY bfd.1 /opt/bfd/bfd.1
COPY bfd.bash-completion /opt/bfd/bfd.bash-completion
COPY tests/ /opt/bfd/tests/

WORKDIR /opt/bfd/tests

CMD ["bats", "--formatter", "tap", "/opt/bfd/tests/"]
