#!/bin/bash
dstamp=$(date +"%m%d%y.%H%M")
mv -f /usr/local/bfd/stats/attack.pool "/usr/local/bfd/stats/attack.pool.$dstamp"
# clear transient state but preserve ban tracking and event data
rm -f /usr/local/bfd/tmp/track.attack
rm -f /usr/local/bfd/tmp/ban.list
rm -f /usr/local/bfd/tmp/.alist.*
rm -f /usr/local/bfd/tmp/.alerts.*
rm -f /usr/local/bfd/tmp/.weekly.apool.*
rm -f /usr/local/bfd/tmp/*.cursor
rm -f /usr/local/bfd/tmp/*.jts
# rotate bans.history (append-only, rotated daily)
if [ -f /usr/local/bfd/tmp/bans.history ]; then
	mv -f /usr/local/bfd/tmp/bans.history "/usr/local/bfd/tmp/bans.history.$(date +%m%d%y)"
fi
# purge rotated bans.history files older than 30 days
find /usr/local/bfd/tmp -maxdepth 1 -name 'bans.history.*' -type f -mtime +30 -delete 2>/dev/null
