# --- Subcommand dispatch functions ---

_dispatch_ban() {
	case "${1:-}" in
		--help|-h|"")	_ban_help; return 0 ;;
		add)
			vhead; pre
			if [ -z "${2:-}" ]; then
				echo "error: ban add requires an IP address." >&2; echo >&2; _ban_help >&2; exit "$EXIT_CONFIG_ERROR"
			fi
			if [ -n "${3:-}" ] && [[ "${3}" == -* ]]; then
				echo "error: service name cannot start with '-': '${3}'" >&2
				echo >&2; _ban_help >&2; exit "$EXIT_CONFIG_ERROR"
			fi
			manual_ban "$INSTALL_PATH" "$2" "$UTIME" "${3:-manual}" "all" || exit "$?"
			;;
		remove)
			vhead; pre
			if [ -z "${2:-}" ]; then
				echo "error: ban remove requires an IP address." >&2; echo >&2; _ban_help >&2; exit "$EXIT_CONFIG_ERROR"
			fi
			manual_unban "$INSTALL_PATH" "$2" "$UTIME" || exit "$?"
			;;
		list)
			[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
			case "$OUTPUT_FORMAT" in
				json) list_bans_json "$INSTALL_PATH" ;;
				csv)  list_bans_csv "$INSTALL_PATH" ;;
				*)    list_bans "$INSTALL_PATH" ;;
			esac
			;;
		flush)
			vhead; pre
			case "${2:-}" in
				temp) flush_bans "$INSTALL_PATH" "temp" "$UTIME" || exit "$?" ;;
				all)  flush_bans "$INSTALL_PATH" "all" "$UTIME" || exit "$?" ;;
				*)    echo "error: flush requires 'temp' or 'all'." >&2; echo >&2; _ban_help >&2; exit "$EXIT_CONFIG_ERROR" ;;
			esac
			;;
		history)
			[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
			case "$OUTPUT_FORMAT" in
				json) ban_history_json "$INSTALL_PATH" "${2:-}" ;;
				csv)  ban_history_csv "$INSTALL_PATH" "${2:-}" ;;
				*)    ban_history "$INSTALL_PATH" "${2:-}" ;;
			esac
			;;
		*)	_cli_unknown_verb "bfd ban" "$1" "add remove list flush history"; exit "$EXIT_CONFIG_ERROR" ;;
	esac
}

