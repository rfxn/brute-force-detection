INSTALL_PATH="/usr/local/bfd"
CNF="$INSTALL_PATH/conf.bfd"
V="2.0.1"
# shellcheck disable=SC2034 # APPN used by importconf
APPN="BFD"
UTIME=$(date +"%s")

# validate library safety before sourcing
_lib_owner=$(stat -c '%u' "$INSTALL_PATH/bfd.lib.sh")
_lib_perms=$(stat -c '%a' "$INSTALL_PATH/bfd.lib.sh")
_lib_world="${_lib_perms: -1}"
if [ "$_lib_owner" != "0" ] || [ "$((_lib_world & 2))" -ne 0 ]; then
	echo "bfd.lib.sh has unsafe ownership (uid=$_lib_owner) or permissions ($_lib_perms), aborting."
	exit 1
fi
# shellcheck source=files/bfd.lib.sh
. "$INSTALL_PATH/bfd.lib.sh"

# initialize variables that may be unset
SKIP_ALERT=""
DRY_RUN=0

# shellcheck disable=SC2317 # called via trap
cleanup() {
	rm -rf "$LOCK_FILE.lk" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null
}
trap cleanup EXIT INT TERM

vhead() {
	echo "Brute Force Detection v$V <bfd@rfxn.com>"
	echo "	(C) 1999-2026, R-fx Networks <proj@rfxn.com>"
	echo "	(C) 2026, Ryan MacDonald <ryan@rfxn.com>"
	echo "This program may be freely redistributed under the terms of the GNU GPL"
	echo ""
}

if [ ! -f "$CNF" ]; then
	vhead
	echo "could not find \$CNF, aborting."
	exit "$EXIT_CONFIG_ERROR"
fi
# validate config file safety before sourcing
_cnf_owner=$(stat -c '%u' "$CNF")
_cnf_perms=$(stat -c '%a' "$CNF")
_cnf_world="${_cnf_perms: -1}"
if [ "$_cnf_owner" != "0" ] || [ "$((_cnf_world & 2))" -ne 0 ]; then
	vhead
	echo "conf.bfd has unsafe ownership (uid=$_cnf_owner) or permissions ($_cnf_perms), aborting."
	exit "$EXIT_CONFIG_ERROR"
fi
# shellcheck disable=SC1090
. "$CNF"
# source internal/derived variables (split from conf.bfd in 2.0.1)
INTCNF="$INSTALL_PATH/internals.conf"
if [ -f "$INTCNF" ]; then
	_int_owner=$(stat -c '%u' "$INTCNF")
	_int_perms=$(stat -c '%a' "$INTCNF")
	_int_world="${_int_perms: -1}"
	if [ "$_int_owner" = "0" ] && [ "$((_int_world & 2))" -eq 0 ]; then
		# shellcheck disable=SC1090
		. "$INTCNF"
	else
		echo "warning: internals.conf has unsafe ownership or permissions, using defaults."
	fi
fi
# fallbacks for internals.conf variables (backward compat with pre-split installs)
RULES_PATH="${RULES_PATH:-$INSTALL_PATH/rules}"
TLOG_PATH="${TLOG_PATH:-$INSTALL_PATH/tlog}"
EMAIL_TEMPLATE="${EMAIL_TEMPLATE:-$INSTALL_PATH/alert.bfd}"
IGNORE_HOST_FILES="${IGNORE_HOST_FILES:-$INSTALL_PATH/exclude.files}"
LOCK_FILE="${LOCK_FILE:-$INSTALL_PATH/lock.utime}"
TIME_ZONE="${TIME_ZONE:-$(date +"%z")}"
GLOB_TRIG="$TRIG"
# load per-rule threshold overrides
declare -A _THRESH_TRIG _THRESH_SKIP_ALERT _THRESH_RULE_EMAIL
_load_thresholds "${THRESHOLDS_CONF:-$INSTALL_PATH/thresholds.conf}"
# extract BAN_COMMAND templates (only needed for custom backend)
BAN_COMMAND_TEMPLATE=$(extract_command_template "$CNF" "BAN_COMMAND")
UNBAN_COMMAND_TEMPLATE=$(extract_command_template "$CNF" "UNBAN_COMMAND")
BAN_COMMAND_V6_TEMPLATE=$(extract_command_template "$CNF" "BAN_COMMAND_V6")
UNBAN_COMMAND_V6_TEMPLATE=$(extract_command_template "$CNF" "UNBAN_COMMAND_V6")

validate_config
detect_log_paths

# resolve firewall backend and run setup
fw_resolve_backend
fw_setup

# warn if BAN_COMMAND binary not found (custom mode only)
if [ "$_FW_BACKEND" = "custom" ]; then
	_ban_cmd_bin=$(echo "$BAN_COMMAND_TEMPLATE" | awk '{print $1}')
	if [ -n "$_ban_cmd_bin" ] && [ ! -x "$_ban_cmd_bin" ]; then
		echo "warning: BAN_COMMAND binary '$_ban_cmd_bin' not found or not executable."
	fi
	if [ -n "$BAN_COMMAND_V6_TEMPLATE" ]; then
		_ban_cmd_v6_bin=$(echo "$BAN_COMMAND_V6_TEMPLATE" | awk '{print $1}')
		if [ -n "$_ban_cmd_v6_bin" ] && [ ! -x "$_ban_cmd_v6_bin" ]; then
			echo "warning: BAN_COMMAND_V6 binary '$_ban_cmd_v6_bin' not found or not executable."
		fi
	fi
	unset _ban_cmd_bin _ban_cmd_v6_bin
fi

pre() {
export LOG_SOURCE
if [ ! -f "$TLOG_PATH" ]; then
	eout "could not locate \$TLOG_PATH, aborting."
	exit "$EXIT_PREREQ_ERROR"
fi
if [ ! -d "$RULES_PATH" ]; then
	eout "could not locate \$RULES_PATH, aborting."
	exit "$EXIT_PREREQ_ERROR"
fi
if [ ! -f "$BFD_LOG_PATH" ]; then
	touch "$BFD_LOG_PATH"
	chmod 600 "$BFD_LOG_PATH"
fi

if [ ! -d "$INSTALL_PATH/stats" ]; then
	mkdir -p "$INSTALL_PATH/stats"
	chmod 750 "$INSTALL_PATH/stats"
fi

APOOL_LIST="$INSTALL_PATH/stats/attack.pool"
if [ -f "$APOOL_LIST" ]; then
	chmod 600 "$APOOL_LIST"
else
	touch "$APOOL_LIST"
	chmod 600 "$APOOL_LIST"
fi

state_init "$INSTALL_PATH"

LO_HOSTS="$INSTALL_PATH/ignore.hosts.local"
IP_BIN=$(command -v ip 2>/dev/null)
if [ -z "$IP_BIN" ]; then
	for _p in /sbin/ip /usr/sbin/ip /usr/bin/ip /bin/ip; do
		if [ -x "$_p" ]; then
			IP_BIN="$_p"
			break
		fi
	done
fi
if [ -n "$IP_BIN" ]; then
	"$IP_BIN" addr list | grep -E 'inet6? ' | tr '/' ' ' | awk '{print$2}' > "$LO_HOSTS"
else
	hostname -I | tr ' ' '\n' > "$LO_HOSTS"
fi
}

get_state() {
if ! mkdir "$LOCK_FILE.lk" 2>/dev/null; then
	# lock dir exists — check staleness
	if [ -f "$LOCK_FILE" ]; then
		OVAL=$(cat "$LOCK_FILE")
		DIFF=$((UTIME - OVAL))
		if [ "$DIFF" -gt "$LOCK_FILE_TIMEOUT" ]; then
			eout "cleared stale lock (${DIFF}s old, pid=$(cat "$LOCK_FILE.lk/pid" 2>/dev/null || echo unknown))."
			rm -rf "$LOCK_FILE.lk"
			mkdir "$LOCK_FILE.lk" 2>/dev/null || {
				eout "unable to acquire lock after stale cleanup, aborting."
				exit "$EXIT_LOCK_ERROR"
			}
		else
			# lock is fresh — verify the holder is still alive
			local _lock_pid
			_lock_pid=$(cat "$LOCK_FILE.lk/pid" 2>/dev/null)
			if [ -n "$_lock_pid" ] && ! kill -0 "$_lock_pid" 2>/dev/null; then
				eout "cleared dead lock (pid=$_lock_pid exited, lock ${DIFF}s old)."
				rm -rf "$LOCK_FILE.lk"
				mkdir "$LOCK_FILE.lk" 2>/dev/null || {
					eout "unable to acquire lock after dead-pid cleanup, aborting."
					exit "$EXIT_LOCK_ERROR"
				}
			else
				eout "locked subsystem, already running ? ($LOCK_FILE is $DIFF seconds old), aborting."
				exit "$EXIT_LOCK_ERROR"
			fi
		fi
	else
		eout "lock directory exists but no timestamp file, aborting."
		exit "$EXIT_LOCK_ERROR"
	fi
fi
echo "$$" > "$LOCK_FILE.lk/pid"
echo "$UTIME" > "$LOCK_FILE"
}

check() {
	local run_start rules_count=0 events_count=0 bans_count=0
	run_start=$(date +"%s")

	# create alerts temp file for batched email delivery
	local alerts_file
	alerts_file=$(mktemp "$INSTALL_PATH/tmp/.alerts.XXXXXX")

	# prune expired events once per run, before iterating rules
	state_events_prune "$INSTALL_PATH" "$TRIG_WINDOW" "$UTIME"

	for str in "$RULES_PATH"/*; do
		str=$(basename "$str")
		eout "processing rule file $str"
		_clear_rule_vars
		safe_source "$RULES_PATH/$str" "rule:$str" || continue
		_apply_thresholds "$str"
		if [ -z "$TRIG" ]; then
			TRIG="$GLOB_TRIG"
		fi
		MOD=$(sanitize_mod "$str") || { eout "invalid rule name '$str', skipping" le; continue; }
		validate_rule "$str" || continue
		rules_count=$((rules_count + 1))
		# process ARG_VAL pipeline once; reuse for iteration and counting
		HOSTS_PARSED=$(echo "$ARG_VAL" | tr ' ' '\n' | sort)
		# count events (raw IP occurrences including duplicates)
		local host_lines
		host_lines=$(echo "$HOSTS_PARSED" | grep -c . 2>/dev/null || echo 0)
		events_count=$((events_count + host_lines))
		while IFS= read -r ahost; do
			[ -z "$ahost" ] && continue
			ATTACK_HOST=$(validate_ip_any "$ahost") || continue
			local filter_rc=0
			filter_host "$ATTACK_HOST" "$IGNORE_HOST_FILES" "$LO_HOSTS" || filter_rc=$?
			if [ "$filter_rc" -eq 1 ]; then
				continue
			fi
			ATTACK_COUNT=$(count_failures "$ATTACK_HOST" "$HOSTS_PARSED" "$INSTALL_PATH" "$TRIG_WINDOW" "$UTIME" "$MOD")
			if [ -z "$ATTACK_COUNT" ]; then
				ATTACK_COUNT=0
			fi
			local should_ban=0
			if [ "$ATTACK_COUNT" -ge "$TRIG" ]; then
				should_ban=1
			elif [ "$TRIG_GLOBAL" -gt 0 ]; then
				local global_count
				global_count=$(state_events_count "$INSTALL_PATH" "$ATTACK_HOST" "$TRIG_WINDOW" "$UTIME")
				if [ "$global_count" -ge "$TRIG_GLOBAL" ]; then
					should_ban=1
				fi
			fi
			if [ "$should_ban" -eq 1 ]; then
				# skip if host already has an active ban
				if state_bans_active_check "$INSTALL_PATH" "$ATTACK_HOST"; then
					continue
				fi
				if [ "$filter_rc" -eq 2 ]; then
					# local address
					state_pool_append "$INSTALL_PATH" "$UTIME" "$ATTACK_HOST" "$MOD"
					eout "{$MOD} $ATTACK_HOST is a local address, skipping ban." le
				else
					state_pool_append "$INSTALL_PATH" "$UTIME" "$ATTACK_HOST" "$MOD"
					if execute_ban "$ATTACK_HOST" "$MOD" "$DRY_RUN" "${PORTS:-all}"; then
						bans_count=$((bans_count + 1))
						local ban_result
						ban_result=$(record_ban "$INSTALL_PATH" "$UTIME" "$ATTACK_HOST" "$MOD" "${PORTS:-all}" "ban")
						local ban_expiry ban_action recent_bans
						IFS='|' read -r ban_expiry ban_action recent_bans <<< "$ban_result"
						# collect alert data for batched delivery
						if [ "$EMAIL_ALERTS" = "1" ] && [ "$SKIP_ALERT" != "1" ] && [ "$DRY_RUN" != "1" ]; then
							local eff_recipient="${RULE_EMAIL:-$EMAIL_ADDRESS}"
							echo "${ATTACK_HOST}|${MOD}|${PORTS:-all}|${ATTACK_COUNT}|${ban_expiry}|${ban_action}|${recent_bans}|${LP}|${eff_recipient}|${TRIG}|${TRIG_WINDOW}" >> "$alerts_file"
						fi
					fi
				fi
			fi
		done < <(echo "$HOSTS_PARSED" | uniq)
	done

	# distributed attack detection
	if [ "${SUBNET_TRIG:-0}" -gt 0 ]; then
		local subnet_bans
		subnet_bans=$(check_distributed "$INSTALL_PATH" "$TRIG_WINDOW" "$UTIME" "$alerts_file")
		bans_count=$((bans_count + subnet_bans))
	fi

	# send batched alert emails
	if [ "$EMAIL_ALERTS" = "1" ] && [ -s "$alerts_file" ]; then
		send_alerts "$alerts_file" "$EMAIL_SUBJECT" "$EMAIL_TEMPLATE" "${EMAIL_LOGLINES:-50}"
	fi
	rm -f "$alerts_file"

	local run_end run_elapsed
	run_end=$(date +"%s")
	run_elapsed=$((run_end - run_start))
	eout "run complete: $rules_count rules checked, $events_count events parsed, $bans_count bans executed (${run_elapsed}s)" le
}

_apool_report() {
	local source_file="$1"
	local title="$2"
	local search="${3:-}"
	local atmp
	atmp=$(mktemp "$INSTALL_PATH/tmp/.alist.XXXXXX")
	echo "[+] $title" && echo
	echo "#TRIGS|IP|FIRST_SEEN|LAST_SEEN|RULES|STATUS" > "$atmp"
	local cnt aip first_ts last_ts mods first_fmt last_fmt ban_status
	while IFS='|' read -r cnt aip first_ts last_ts mods; do
		[ -z "$cnt" ] && continue
		first_fmt=$(date -d "@${first_ts}" +"%D %H:%M:%S" 2>/dev/null || echo "$first_ts")
		last_fmt=$(date -d "@${last_ts}" +"%D %H:%M:%S" 2>/dev/null || echo "$last_ts")
		ban_status=$(_apool_ban_status "$aip")
		echo "$cnt|$aip|$first_fmt|$last_fmt|$mods|$ban_status" >> "$atmp"
	done < <(
		if [ -n "$search" ]; then
			grep -F "$search" "$source_file"
		else
			cat "$source_file"
		fi | awk '{
			ip = $2; ts = $1 + 0; rule = $3
			count[ip]++
			if (!(ip in first) || ts < first[ip]) first[ip] = ts
			if (!(ip in last) || ts > last[ip]) last[ip] = ts
			if (rules[ip] == "") rules[ip] = rule
			else if (index(rules[ip], rule) == 0) rules[ip] = rules[ip] "," rule
		}
		END {
			for (ip in count)
				print count[ip] "|" ip "|" first[ip] "|" last[ip] "|" rules[ip]
		}' | sort -t'|' -k1 -nr | head -n 25
	)
	format_table < "$atmp"
	rm -f "$atmp"
}

# _apool_ban_status ip — return ban status string for an IP
_apool_ban_status() {
	local aip="$1"
	local bans_active="$INSTALL_PATH/tmp/bans.active"
	local bans_history="$INSTALL_PATH/tmp/bans.history"
	if awk -v ip="$aip" '$3 == ip {found=1; exit} END {exit !found}' "$bans_active" 2>/dev/null; then
		local ban_expiry
		ban_expiry=$(awk -v ip="$aip" '$3 == ip {print $2; exit}' "$bans_active")
		if [ "$ban_expiry" = "0" ]; then
			echo "BANNED(perm)"
		else
			local now remain
			now=$(date +"%s")
			remain=$(( (ban_expiry - now) / 60 ))
			if [ "$remain" -lt 0 ]; then
				remain=0
			fi
			echo "BANNED(${remain}m)"
		fi
	elif [ -f "$bans_history" ]; then
		local hist_count
		hist_count=$(awk -v ip="$aip" '$3 == ip && ($5 == "ban" || $5 == "escalate") {c++} END {print c+0}' \
			"$bans_history")
		if [ "$hist_count" -gt 0 ]; then
			echo "prev:$hist_count"
		fi
	fi
}

# _apool_service_summary source_file — per-service event and unique IP breakdown
_apool_service_summary() {
	local source_file="$1"
	if [ ! -f "$source_file" ] || [ ! -s "$source_file" ]; then
		return 0
	fi
	local atmp
	atmp=$(mktemp "$INSTALL_PATH/tmp/.svcsum.XXXXXX")
	echo "[+] Per-service breakdown" && echo
	echo "SERVICE|EVENTS|UNIQUE_IPS" > "$atmp"
	awk '{
		svc[$3]++
		key = $3 " " $2
		if (!(key in seen)) { seen[key] = 1; uniq[$3]++ }
	}
	END {
		for (s in svc) print svc[s] "|" s "|" uniq[s]
	}' "$source_file" | sort -t'|' -k1 -nr >> "$atmp"
	format_table < "$atmp"
	rm -f "$atmp"
}

apool_list() {
	local ahost="${1:-}"
	if [ -n "$ahost" ]; then
		local WAPOOL_LIST
		WAPOOL_LIST=$(mktemp "$INSTALL_PATH/tmp/.weekly.apool.XXXXXX")
		find "$APOOL_LIST"* -type f -mtime -7 -exec cat {} + > "$WAPOOL_LIST" 2>/dev/null
		_apool_report "$WAPOOL_LIST" "Events for search string \"$ahost\"" "$ahost"
		rm -f "$WAPOOL_LIST"
	elif [ -f "$APOOL_LIST" ]; then
		_apool_report "$APOOL_LIST" "Top 25 brute force attackers today"
		echo
		_apool_service_summary "$APOOL_LIST"
		echo
		local WAPOOL_LIST
		WAPOOL_LIST=$(mktemp "$INSTALL_PATH/tmp/.weekly.apool.XXXXXX")
		find "$APOOL_LIST"* -type f -mtime -7 -exec cat {} + > "$WAPOOL_LIST" 2>/dev/null
		_apool_report "$WAPOOL_LIST" "Top 25 brute force attackers this week"
		rm -f "$WAPOOL_LIST"
	fi
}

run() {
	pre
	get_state
	process_unbans "$INSTALL_PATH" "$UTIME"
	check
}

# shellcheck disable=SC2317 # called via trap
cleanup_watch() {
	eout "watch mode shutting down (pid=$$)" le
	rm -rf "$LOCK_FILE.lk" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null
}

# shellcheck disable=SC2317 # called via trap
reload_watch() {
	eout "watch mode reloading configuration (SIGHUP)" le
	# re-source config with same safety checks as startup
	local _cnf_owner _cnf_perms _cnf_world
	_cnf_owner=$(stat -c '%u' "$CNF")
	_cnf_perms=$(stat -c '%a' "$CNF")
	_cnf_world="${_cnf_perms: -1}"
	if [ "$_cnf_owner" != "0" ] || [ "$((_cnf_world & 2))" -ne 0 ]; then
		eout "reload aborted: conf.bfd has unsafe ownership or permissions" le
		return 1
	fi
	# shellcheck disable=SC1090
	. "$CNF"
	if [ -f "$INTCNF" ]; then
		local _int_owner _int_perms _int_world
		_int_owner=$(stat -c '%u' "$INTCNF")
		_int_perms=$(stat -c '%a' "$INTCNF")
		_int_world="${_int_perms: -1}"
		if [ "$_int_owner" = "0" ] && [ "$((_int_world & 2))" -eq 0 ]; then
			# shellcheck disable=SC1090
			. "$INTCNF"
		fi
	fi
	GLOB_TRIG="$TRIG"
	_load_thresholds "${THRESHOLDS_CONF:-$INSTALL_PATH/thresholds.conf}"
	# shellcheck disable=SC2034  # templates used by _fw_custom_ban/unban
	BAN_COMMAND_TEMPLATE=$(extract_command_template "$CNF" "BAN_COMMAND")
	UNBAN_COMMAND_TEMPLATE=$(extract_command_template "$CNF" "UNBAN_COMMAND")
	BAN_COMMAND_V6_TEMPLATE=$(extract_command_template "$CNF" "BAN_COMMAND_V6")
	UNBAN_COMMAND_V6_TEMPLATE=$(extract_command_template "$CNF" "UNBAN_COMMAND_V6")
	validate_config
	detect_log_paths
	fw_resolve_backend
	fw_setup
	# refresh local IPs
	if [ -n "$IP_BIN" ]; then
		"$IP_BIN" addr list | grep -E 'inet6? ' | tr '/' ' ' | awk '{print$2}' > "$LO_HOSTS"
	else
		hostname -I | tr ' ' '\n' > "$LO_HOSTS"
	fi
	eout "watch mode reload complete (WATCH_INTERVAL=${WATCH_INTERVAL}s)" le
}

watch() {
	trap cleanup_watch EXIT INT TERM
	trap reload_watch HUP
	pre
	get_state
	eout "watch mode started (interval=${WATCH_INTERVAL}s, pid=$$)" le
	while true; do
		UTIME=$(date +"%s")
		echo "$UTIME" > "$LOCK_FILE"
		process_unbans "$INSTALL_PATH" "$UTIME"
		check
		sleep "$WATCH_INTERVAL" &
		wait "$!"
	done
}

usage() {
	echo "usage: $0 [OPTION]"
	echo "-s|--standard .............. run standard with output"
	echo "-q|--quiet ................. run quiet with output hidden"
	echo "-d|--dryrun ................ run detection without banning"
	echo "-w|--watch ................. run in continuous watch mode (foreground)"
	echo "-a|--attackpool [IP|STR] ... attack pool; valid IP shows full report"
	echo "-c|--check ................. health check and diagnostics"
	echo "-l|--list .................. list active bans"
	echo "-u|--unban IP .............. unban an IP address"
	echo "-b|--ban IP [SERVICE] ...... manually ban an IP (permanent)"
	echo "-S|--status [SERVICE] ...... system or per-service status"
	echo "-C|--config [VAR] .......... show config values"
	echo "-R|--rules [RULE] .......... list rules or show rule details"
	echo "-T|--test RULE [FILE|-] .... test rule patterns against log or stdin"
	echo "   --test-pattern PAT [FILE|-] test a raw <HOST> pattern against log or stdin"
	echo "   --flush-temp ............ unban all temporary bans"
	echo "   --flush-all ............. unban all bans"
	echo "   --json .................. output in JSON format (with -l)"
	echo "   --csv ................... output in CSV format (with -l)"
	echo "-v|--version ............... display version"
	echo "-h|--help .................. display this help"
}

# Pre-process global modifier flags (--json, --csv)
OUTPUT_FORMAT="table"
declare -a _bfd_args=()
for _arg in "$@"; do
	case "$_arg" in
		--json) OUTPUT_FORMAT="json" ;;
		--csv)  OUTPUT_FORMAT="csv" ;;
		*)      _bfd_args+=("$_arg") ;;
	esac
done
set -- "${_bfd_args[@]+"${_bfd_args[@]}"}"

case "${1:-}" in
-s|--standard)  vhead; run ;;
-q|--quiet)     exec >/dev/null 2>&1; run ;;
-d|--dryrun)    DRY_RUN=1; vhead; run ;;
-w|--watch)     vhead; watch ;;
-a|--attackpool)
	vhead; pre
	if [ -n "${2:-}" ] && validate_ip_any "$2" >/dev/null 2>&1; then
		search_ip "$INSTALL_PATH" "$2"
	else
		apool_list "${2:-}"
	fi
	;;
-c|--check)     vhead; pre; health_check "$INSTALL_PATH" ;;
-l|--list)
	vhead; pre
	case "$OUTPUT_FORMAT" in
		json) list_bans_json "$INSTALL_PATH" ;;
		csv)  list_bans_csv "$INSTALL_PATH" ;;
		*)    list_bans "$INSTALL_PATH" ;;
	esac
	;;
-u|--unban)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -u requires an IP address."; echo; usage; exit "$EXIT_CONFIG_ERROR"
	fi
	manual_unban "$INSTALL_PATH" "$2" "$UTIME" || exit "$?"
	;;
-b|--ban)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -b requires an IP address."; echo; usage; exit "$EXIT_CONFIG_ERROR"
	fi
	manual_ban "$INSTALL_PATH" "$2" "$UTIME" "${3:-manual}" "all" || exit "$?"
	;;
-S|--status)
	vhead; pre
	if [ -n "${2:-}" ]; then
		show_service_status "$INSTALL_PATH" "$2" || exit "$?"
	else
		show_status "$INSTALL_PATH" || exit "$?"
	fi
	;;
-C|--config)    show_config "${2:-}" || exit "$?" ;;
-R|--rules)
	vhead; pre
	if [ -n "${2:-}" ]; then
		show_rule "$INSTALL_PATH" "$2" || exit "$?"
	else
		list_rules "$INSTALL_PATH" || exit "$?"
	fi
	;;
-T|--test)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -T requires a rule name."; echo; usage; exit "$EXIT_CONFIG_ERROR"
	fi
	test_rule "$INSTALL_PATH" "$2" "${3:-}" || exit "$?"
	;;
--test-pattern)
	vhead
	if [ -z "${2:-}" ]; then
		echo "error: --test-pattern requires a pattern."; echo; usage; exit "$EXIT_CONFIG_ERROR"
	fi
	test_pattern "$2" "${3:-}" || exit "$?"
	;;
--flush-temp)   vhead; pre; flush_bans "$INSTALL_PATH" "temp" "$UTIME" || exit "$?" ;;
--flush-all)    vhead; pre; flush_bans "$INSTALL_PATH" "all" "$UTIME" || exit "$?" ;;
-v|--version)   vhead ;;
-h|--help)      vhead; usage ;;
"")             vhead; usage ;;
*)              vhead; echo "error: unknown option '$1'"; echo; usage; exit "$EXIT_CONFIG_ERROR" ;;
esac
exit "$EXIT_OK"
