_dispatch_cdn() {
	case "${1:-}" in
		--help|-h)	_cdn_help; return 0 ;;
		update) pre; cdn_update "$INSTALL_PATH" ;;
		check)
			pre
			if [ -z "${2:-}" ]; then
				echo "error: cdn check requires an IP address." >&2; echo >&2; _cdn_help >&2; exit "$EXIT_CONFIG_ERROR"
			fi
			if ! validate_ip_any "$2" >/dev/null 2>&1; then
				echo "error: invalid IP address '${2}'." >&2; exit "$EXIT_CONFIG_ERROR"
			fi
			case "$OUTPUT_FORMAT" in
				json) cdn_check_ip_json "$INSTALL_PATH" "$2" ;;
				*)    cdn_check_ip "$INSTALL_PATH" "$2" ;;
			esac
			;;
		"")
			pre
			case "$OUTPUT_FORMAT" in
				json) cdn_list_json "$INSTALL_PATH" ;;
				*)    [ "$OUTPUT_FORMAT" = "table" ] && vhead; cdn_list "$INSTALL_PATH" ;;
			esac
			;;
		*)
			pre
			case "$OUTPUT_FORMAT" in
				json) cdn_detail_json "$INSTALL_PATH" "$1" ;;
				*)    [ "$OUTPUT_FORMAT" = "table" ] && vhead; cdn_detail "$INSTALL_PATH" "$1" ;;
			esac
			;;
	esac
}

_dispatch_report() {
	case "${1:-}" in
		--help|-h)	_report_help; return 0 ;;
		*)
			vhead; pre
			local _rpt_interval="${1:-}"
			if [ -z "$_rpt_interval" ]; then
				case "$_EVENTS_WINDOW" in
					7d)  _rpt_interval="weekly" ;;
					30d) _rpt_interval="monthly" ;;
					*)   _rpt_interval="daily" ;;
				esac
			fi
			report "$_rpt_interval" || exit "$?"
			;;
	esac
}

_dispatch_status() {
	case "${1:-}" in
		--help|-h)	_status_help; return 0 ;;
		"")		vhead; pre; show_status "$INSTALL_PATH" || exit "$?" ;;
		lock)		status_lock "$INSTALL_PATH" ;;
		cursors)	pre; status_cursors "$INSTALL_PATH" ;;
		pool)		pre; status_pool "$INSTALL_PATH" ;;
		pressure)	pre; status_pressure "$INSTALL_PATH" "${2:-}" ;;
		*)		vhead; pre; show_service_status "$INSTALL_PATH" "$1" || exit "$?" ;;
	esac
}

# Pre-process global modifier flags (--json, --csv, --verbose, --max-lines=, --scan-timeout=,
# --sort=, --24h, --7d, --30d, --limit=, --active)
VERBOSE=0
OUTPUT_FORMAT="table"
_CLI_SCAN_MAX_LINES=""
_CLI_SCAN_TIMEOUT=""
_EVENTS_SORT="count"
_EVENTS_WINDOW="24h"
_EVENTS_LIMIT="100"
_RULES_ACTIVE_ONLY=0
declare -a _bfd_args=()
# shellcheck disable=SC2034
for _arg in "$@"; do
	case "$_arg" in
		--json) OUTPUT_FORMAT="json" ;;
		--csv)  OUTPUT_FORMAT="csv" ;;
		--verbose|-V) VERBOSE=1; ELOG_VERBOSE=1 ;;
		--max-lines=*) _CLI_SCAN_MAX_LINES="${_arg#--max-lines=}" ;;
		--scan-timeout=*) _CLI_SCAN_TIMEOUT="${_arg#--scan-timeout=}" ;;
		--sort=*) _EVENTS_SORT="${_arg#--sort=}" ;;
		--limit=*) _EVENTS_LIMIT="${_arg#--limit=}" ;;
		--24h) _EVENTS_WINDOW="24h" ;;
		--7d)  _EVENTS_WINDOW="7d" ;;
		--30d) _EVENTS_WINDOW="30d" ;;
		--active) _RULES_ACTIVE_ONLY=1 ;;
		*)      _bfd_args+=("$_arg") ;;
	esac
done
set -- "${_bfd_args[@]+"${_bfd_args[@]}"}"
# Validate --sort= value
case "$_EVENTS_SORT" in
	count|time|ip) ;;
	*) echo "warning: unknown sort mode '$_EVENTS_SORT', using 'count'" >&2
	   _EVENTS_SORT="count" ;;
esac
# Validate --limit= value (must be non-negative integer)
case "$_EVENTS_LIMIT" in
	''|*[!0-9]*) echo "warning: invalid limit '$_EVENTS_LIMIT', using '100'" >&2
	   _EVENTS_LIMIT="100" ;;
esac
# Compute _EVENTS_CUTOFF from window selection
case "$_EVENTS_WINDOW" in
	7d)  _EVENTS_CUTOFF=$(( $(date +%s) - 604800 )) ;;
	30d) _EVENTS_CUTOFF=$(( $(date +%s) - 2592000 )) ;;
	*)   _EVENTS_CUTOFF=$(( $(date +%s) - 86400 )) ;;
esac

case "${1:-}" in
-s|--standard)  vhead; bfd_run ;;
-q|--quiet)     exec >/dev/null; bfd_run ;;
-d|--dryrun)    DRY_RUN=1; vhead; bfd_run ;;
-w|--watch)     vhead; watch ;;
-a|--attackpool|--activity)
	[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
	if [ -n "${2:-}" ] && validate_ip_any "$2" >/dev/null 2>&1; then
		case "$OUTPUT_FORMAT" in
			json) search_ip_json "$INSTALL_PATH" "$2" ;;
			csv)  search_ip_csv "$INSTALL_PATH" "$2" ;;
			*)    search_ip "$INSTALL_PATH" "$2" ;;
		esac
	else
		case "$OUTPUT_FORMAT" in
			json) apool_list_json "${2:-}" ;;
			csv)  apool_list_csv "${2:-}" ;;
			*)    apool_list "${2:-}" ;;
		esac
	fi
	;;
-e|--events)
	[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
	if [ -n "${2:-}" ] && validate_ip_any "$2" >/dev/null 2>&1; then
		case "$OUTPUT_FORMAT" in
			json) events_list_ip_json "$INSTALL_PATH" "$2" "${3:-}" ;;
			csv)  events_list_ip_csv "$INSTALL_PATH" "$2" ;;
			*)    events_list_ip "$INSTALL_PATH" "$2" "${3:-}" ;;
		esac
	elif [ -n "${2:-}" ] && [[ "$2" == */* ]]; then
		case "$OUTPUT_FORMAT" in
			json) events_list_cidr_json "$INSTALL_PATH" "$2" "$_EVENTS_SORT" "$_EVENTS_LIMIT" || exit "$?" ;;
			csv)  events_list_cidr_csv "$INSTALL_PATH" "$2" "$_EVENTS_SORT" "$_EVENTS_LIMIT" || exit "$?" ;;
			*)    events_list_cidr "$INSTALL_PATH" "$2" "$_EVENTS_SORT" "$_EVENTS_LIMIT" || exit "$?" ;;
		esac
	else
		case "$OUTPUT_FORMAT" in
			json) events_list_json "$INSTALL_PATH" "$_EVENTS_SORT" "$_EVENTS_LIMIT" ;;
			csv)  events_list_csv "$INSTALL_PATH" "$_EVENTS_SORT" "$_EVENTS_LIMIT" ;;
			*)    events_list "$INSTALL_PATH" "$_EVENTS_SORT" "$_EVENTS_LIMIT" ;;
		esac
	fi
	;;
-c|--check)     vhead; pre; health_check "$INSTALL_PATH" ;;
-l|--list)
	[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
	case "$OUTPUT_FORMAT" in
		json) list_bans_json "$INSTALL_PATH" ;;
		csv)  list_bans_csv "$INSTALL_PATH" ;;
		*)    list_bans "$INSTALL_PATH" ;;
	esac
	;;
-u|--unban)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -u requires an IP address." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	manual_unban "$INSTALL_PATH" "$2" "$UTIME" || exit "$?"
	;;
-b|--ban)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -b requires an IP address." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	if [ -n "${3:-}" ] && [[ "${3}" == -* ]]; then
		echo "error: service name cannot start with '-': '${3}'" >&2
		echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	manual_ban "$INSTALL_PATH" "$2" "$UTIME" "${3:-manual}" "all" || exit "$?"
	;;
-S|--status)
	vhead; pre
	if [ -n "${2:-}" ]; then
		show_service_status "$INSTALL_PATH" "$2" || exit "$?"
	else
		show_status "$INSTALL_PATH" || exit "$?"
	fi
	;;
-C|--config)    show_config "${2:-}" || exit "$?" ;;
-R|--rules)
	vhead; pre
	if [ -n "${2:-}" ]; then
		show_rule "$INSTALL_PATH" "$2" || exit "$?"
	else
		list_rules "$INSTALL_PATH" "$_RULES_ACTIVE_ONLY" || exit "$?"
	fi
	;;
-T|--test)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -T requires a rule name." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	test_rule "$INSTALL_PATH" "$2" "${3:-}" || exit "$?"
	;;
--test-pattern)
	vhead
	if [ -z "${2:-}" ]; then
		echo "error: --test-pattern requires a pattern." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	test_pattern "$2" "${3:-}" || exit "$?"
	;;
--test-alert)
	vhead; pre
	test_alert "$INSTALL_PATH" "${2:-}" || exit "$?"
	;;
--scan)		_run_scan "${@:2}" ;;
--report)	_dispatch_report "${@:2}" ;;
--cdn)		_dispatch_cdn "${@:2}" ;;
--flush-temp)   vhead; pre; flush_bans "$INSTALL_PATH" "temp" "$UTIME" || exit "$?" ;;
--flush-all)    vhead; pre; flush_bans "$INSTALL_PATH" "all" "$UTIME" || exit "$?" ;;
# --- Tier 2: Subcommand dispatch ---
ban)		_dispatch_ban "${@:2}" ;;
ignore)		_dispatch_ignore "${@:2}" ;;
test)		_dispatch_test "${@:2}" ;;
cdn)		_dispatch_cdn "${@:2}" ;;
report)		_dispatch_report "${@:2}" ;;
status)		_dispatch_status "${@:2}" ;;
-v|--version)   vhead ;;
-h)		vhead; usage ;;
--help)
	# Progressive disclosure: --help opens man page, falls back to -h
	if command -v man >/dev/null 2>&1 && \
	   man -w bfd >/dev/null 2>&1 && \
	   ! man bfd 2>&1 | command head -1 | command grep -q "minimized"; then  # safe: detect man stub on minimized Docker images
		man bfd
	else
		vhead; usage
	fi
	;;
help)
	case "${2:-}" in
		"")		vhead; usage_short ;;
		ban)		_dispatch_ban --help ;;
		ignore)		_dispatch_ignore --help ;;
		test)		_dispatch_test --help ;;
		cdn)		_dispatch_cdn --help ;;
		report)		_dispatch_report --help ;;
		status)		_dispatch_status --help ;;
		*)		echo "bfd: unknown topic '${2}'. See 'bfd help'." >&2; exit "$EXIT_CONFIG_ERROR" ;;
	esac
	;;
"")             vhead; usage_short ;;
*)
	_cli_unknown_command "bfd" "$1" "ban ignore test cdn report status help -s -q -d -w -a -e -c -l -u -b -S -C -R -T -v -h"
	exit "$EXIT_CONFIG_ERROR"
	;;
esac
exit "$EXIT_OK"
