INSTALL_PATH="/usr/local/bfd"
# shellcheck disable=SC2034 # CNF used by config_init in bfd_core.sh
CNF="$INSTALL_PATH/conf.bfd"
# shellcheck disable=SC2034 # INTCNF used by config_init in bfd_core.sh
INTCNF="$INSTALL_PATH/internals/internals.conf"
V="2.0.2"
# shellcheck disable=SC2034 # APPN used by importconf
APPN="BFD"
UTIME=$(date +"%s")

# inline: _check_file_safety unavailable before bfd.lib.sh is sourced
_lib_owner=$(stat -L -c '%u' "$INSTALL_PATH/internals/bfd.lib.sh")
_lib_perms=$(stat -L -c '%04a' "$INSTALL_PATH/internals/bfd.lib.sh")
_lib_group="${_lib_perms:2:1}"
_lib_world="${_lib_perms:3:1}"
if [ "$_lib_owner" != "0" ] || [ "$((_lib_group & 2))" -ne 0 ] || [ "$((_lib_world & 2))" -ne 0 ]; then
	echo "bfd.lib.sh has unsafe ownership (uid=$_lib_owner) or group/world-writable permissions ($_lib_perms), aborting."
	exit 1
fi
# shellcheck source=files/internals/bfd.lib.sh
. "$INSTALL_PATH/internals/bfd.lib.sh"

# initialize variables that may be unset
# shellcheck disable=SC2034 # SKIP_ALERT read by check() in bfd_core.sh
SKIP_ALERT=""
DRY_RUN=0
_IGNORE_CACHE_FILE=""

# ELOG constants (BFD-specific, never change on reload)
# shellcheck disable=SC2034
ELOG_APP="bfd"
# shellcheck disable=SC2034
ELOG_TS_FORMAT="%b %e %H:%M:%S"
# shellcheck disable=SC2034
ELOG_STDOUT="always"
# shellcheck disable=SC2034
ELOG_STDOUT_PREFIX="full"

# Associative arrays — must be at global scope (declare -A inside functions
# creates locals in bash 4.1, breaking the pressure model)
declare -A _PRESS_WEIGHT _PRESS_TRIP _PRESS_SKIP_ALERT _PRESS_RULE_EMAIL
declare -A _THRESH_TRIG _THRESH_SKIP_ALERT _THRESH_RULE_EMAIL

trap cleanup EXIT INT TERM

vhead() {
	echo "Brute Force Detection v$V <bfd@rfxn.com>"
	echo "	(C) 1999-2026, R-fx Networks <proj@rfxn.com>"
	echo "	(C) 2026, Ryan MacDonald <ryan@rfxn.com>"
	echo "This program may be freely redistributed under the terms of the GNU GPL"
	echo ""
}

if ! config_init; then
	elog_event "config_error" "error" "configuration initialization failed"
	vhead
	exit "$EXIT_CONFIG_ERROR"
fi
# warn if BAN_COMMAND binary not found (custom mode only)
if [ "$_FW_BACKEND" = "custom" ]; then
	_ban_cmd_bin=$(echo "$BAN_COMMAND_TEMPLATE" | awk '{print $1}')
	if [ -n "$_ban_cmd_bin" ] && [ ! -x "$_ban_cmd_bin" ]; then
		echo "warning: BAN_COMMAND binary '$_ban_cmd_bin' not found or not executable." >&2
	fi
	if [ -n "$BAN_COMMAND_V6_TEMPLATE" ]; then
		_ban_cmd_v6_bin=$(echo "$BAN_COMMAND_V6_TEMPLATE" | awk '{print $1}')
		if [ -n "$_ban_cmd_v6_bin" ] && [ ! -x "$_ban_cmd_v6_bin" ]; then
			echo "warning: BAN_COMMAND_V6 binary '$_ban_cmd_v6_bin' not found or not executable." >&2
		fi
	fi
	unset _ban_cmd_bin _ban_cmd_v6_bin
fi

