INSTALL_PATH="/usr/local/bfd"
CNF="$INSTALL_PATH/conf.bfd"
V="2.0.1"
# shellcheck disable=SC2034 # APPN used by importconf
APPN="BFD"
UTIME=$(date +"%s")

# source function library
# shellcheck source=files/bfd.lib.sh
. "$INSTALL_PATH/bfd.lib.sh"

# initialize variables that may be unset
LAST_HOST=""
LAST=""
SKIP_ALERT=""
DRY_RUN=0

# shellcheck disable=SC2317 # called via trap
cleanup() {
	rm -f "$LOCK_FILE"
	eval "exec $LOCK_FD>&-" 2>/dev/null
}
trap cleanup EXIT INT TERM

vhead() {
	echo "Brute Force Detection v$V <bfd@rfxn.com>"
	echo "	(C) 1999-2026, R-fx Networks <proj@rfxn.com>"
	echo "	(C) 2026, Ryan MacDonald <ryan@rfxn.com>"
	echo "This program may be freely redistributed under the terms of the GNU GPL"
	echo ""
}

if [ ! -f "$CNF" ]; then
	vhead
	echo "could not find \$CNF, aborting."
	exit $EXIT_CONFIG_ERROR
fi
# validate config file safety before sourcing
_cnf_owner=$(stat -c '%u' "$CNF")
_cnf_perms=$(stat -c '%a' "$CNF")
_cnf_world="${_cnf_perms: -1}"
if [ "$_cnf_owner" != "0" ] || [ "$((_cnf_world & 2))" -ne 0 ]; then
	vhead
	echo "conf.bfd has unsafe ownership (uid=$_cnf_owner) or permissions ($_cnf_perms), aborting."
	exit $EXIT_CONFIG_ERROR
fi
# shellcheck disable=SC1090
. "$CNF"
GLOB_TRIG="$TRIG"
# extract BAN_COMMAND template without shell expansion of $ATTACK_HOST/$MOD
BAN_COMMAND_TEMPLATE=$(grep '^BAN_COMMAND=' "$CNF" | tail -1 | sed "s/^BAN_COMMAND=//;s/^\"//;s/\"$//")
UNBAN_COMMAND_TEMPLATE=$(grep '^UNBAN_COMMAND=' "$CNF" | tail -1 | sed "s/^UNBAN_COMMAND=//;s/^\"//;s/\"$//")

validate_config
detect_log_paths

# warn if BAN_COMMAND binary not found
BAN_CMD_BIN=$(echo "$BAN_COMMAND_TEMPLATE" | awk '{print $1}')
if [ -n "$BAN_CMD_BIN" ] && [ ! -x "$BAN_CMD_BIN" ]; then
	echo "warning: BAN_COMMAND binary '$BAN_CMD_BIN' not found or not executable."
fi

pre() {
if [ ! -f "$TLOG_PATH" ]; then
	eout "could not locate \$TLOG_PATH, aborting."
	exit $EXIT_PREREQ_ERROR
fi
if [ ! -d "$RULES_PATH" ]; then
	eout "could not locate \$RULES_PATH, aborting."
	exit $EXIT_PREREQ_ERROR
fi
if [ ! -f "$BFD_LOG_PATH" ]; then
	touch "$BFD_LOG_PATH"
	chmod 600 "$BFD_LOG_PATH"
fi

if [ ! -d "$INSTALL_PATH/stats" ]; then
	mkdir -p "$INSTALL_PATH/stats"
	chmod 750 "$INSTALL_PATH"
fi

APOOL_LIST="$INSTALL_PATH/stats/attack.pool"
if [ -f "$APOOL_LIST" ]; then
	chmod 600 "$APOOL_LIST"
else
	touch "$APOOL_LIST"
	chmod 600 "$APOOL_LIST"
fi

BAN_LIST="$INSTALL_PATH/tmp/ban.list"
if [ ! -f "$BAN_LIST" ]; then
	touch "$BAN_LIST"
	chmod 600 "$BAN_LIST"
fi

LO_HOSTS="$INSTALL_PATH/ignore.hosts.local"
IP_BIN=$(command -v ip 2>/dev/null)
if [ -z "$IP_BIN" ]; then
	for _p in /sbin/ip /usr/sbin/ip /usr/bin/ip /bin/ip; do
		if [ -x "$_p" ]; then
			IP_BIN="$_p"
			break
		fi
	done
fi
if [ -n "$IP_BIN" ]; then
	"$IP_BIN" addr list | grep -w inet | tr '/' ' ' | awk '{print$2}' > "$LO_HOSTS"
else
	hostname -I | tr ' ' '\n' > "$LO_HOSTS"
fi
}

LOCK_FD=9

get_state() {
eval "exec $LOCK_FD>\"$LOCK_FILE\""
if ! flock -n $LOCK_FD; then
	# flock failed — check for stale lock as secondary safety net
	if [ -f "$LOCK_FILE" ]; then
		OVAL=$(cat "$LOCK_FILE")
		DIFF=$((UTIME - OVAL))
		if [ "$DIFF" -gt "$LOCK_FILE_TIMEOUT" ]; then
			eout "cleared stale lock file (flock held by dead process)."
			# force-acquire by removing and re-opening
			rm -f "$LOCK_FILE"
			eval "exec $LOCK_FD>\"$LOCK_FILE\""
			flock -n $LOCK_FD || { eout "unable to acquire lock after stale cleanup, aborting."; exit $EXIT_LOCK_ERROR; }
		else
			eout "locked subsystem, already running ? ($LOCK_FILE is $DIFF seconds old), aborting."
			exit $EXIT_LOCK_ERROR
		fi
	else
		eout "unable to acquire lock, aborting."
		exit $EXIT_LOCK_ERROR
	fi
fi
echo "$UTIME" > "$LOCK_FILE"
}

alert() {
if [ "$EMAIL_ALERTS" == "1" ]; then
	# shellcheck disable=SC1090
	. "$EMAIL_TEMPLATE" | mail -s "$EMAIL_SUBJECT" "$EMAIL_ADDRESS"
fi
}


check() {
	# prune expired events once per run, before iterating rules
	state_events_prune "$INSTALL_PATH" "$TRIG_WINDOW" "$UTIME"

	for str in "$RULES_PATH"/*; do
		str=$(basename "$str")
		eout "processing rule file $str"
		TRIG=""
		ARG_VAL=""
		SKIP_ALERT=""
		LP=""
		TLOG_TF=""
		safe_source "$RULES_PATH/$str" "rule:$str" || continue
		if [ -z "$TRIG" ]; then
			TRIG="$GLOB_TRIG"
		fi
		MOD=$(sanitize_mod "$str") || { eout "invalid rule name '$str', skipping" le; continue; }
		validate_rule "$str" || continue
		# process ARG_VAL pipeline once; reuse for iteration and counting
		HOSTS_PARSED=$(echo "$ARG_VAL" | tr ' ' '\n' | tr ':' ' ' | awk '{print$1}' | sort -n)
		while IFS= read -r ahost; do
			[ -z "$ahost" ] && continue
			ATTACK_HOST=$(validate_ip "$ahost") || continue
			local filter_rc=0
			filter_host "$ATTACK_HOST" "$IGNORE_HOST_FILES" "$LO_HOSTS" || filter_rc=$?
			if [ "$filter_rc" -eq 1 ]; then
				continue
			fi
			ATTACK_COUNT=$(count_failures "$ATTACK_HOST" "$HOSTS_PARSED" "$INSTALL_PATH" "$TRIG_WINDOW" "$UTIME" "$MOD")
			if [ -z "$ATTACK_COUNT" ]; then
				ATTACK_COUNT=0
			fi
			local should_ban=0
			if [ "$ATTACK_COUNT" -ge "$TRIG" ]; then
				should_ban=1
			elif [ "$TRIG_GLOBAL" -gt 0 ]; then
				local global_count
				global_count=$(state_events_count "$INSTALL_PATH" "$ATTACK_HOST" "$TRIG_WINDOW" "$UTIME")
				if [ "$global_count" -ge "$TRIG_GLOBAL" ]; then
					should_ban=1
				fi
			fi
			if [ "$should_ban" -eq 1 ]; then
				# skip if host already has an active ban
				if state_bans_active_check "$INSTALL_PATH" "$ATTACK_HOST"; then
					continue
				fi
				SKIP=0
				state_ban_append "$INSTALL_PATH" "$ATTACK_HOST" 50
				if [ "$SKIP" == "0" ]; then
					if [ "$filter_rc" -eq 2 ]; then
						# local address
						eout "{$MOD} $ATTACK_HOST is equal to a local address." le
						if [ "$LAST" != "$ATTACK_HOST" ]; then
							state_pool_append "$INSTALL_PATH" "$UTIME" "$ATTACK_HOST" "$MOD"
							LAST="$ATTACK_HOST"
							eout "{$MOD} $ATTACK_HOST exceeded maximum login failures; host already banned or ignored." le
						fi
					elif [ "$LAST_HOST" != "$ATTACK_HOST" ]; then
						state_pool_append "$INSTALL_PATH" "$UTIME" "$ATTACK_HOST" "$MOD"
						LAST_HOST="$ATTACK_HOST"
						execute_ban "$ATTACK_HOST" "$MOD" "$BAN_COMMAND_TEMPLATE" "$DRY_RUN"
						if [ "$SKIP_ALERT" != "1" ] && [ "$DRY_RUN" != "1" ]; then
							alert
							SKIP_ALERT=""
						fi
						# record ban in lifecycle state
						local ban_expiry
						if [ "${BAN_DURATION:-0}" -eq 0 ]; then
							ban_expiry=0
						elif check_recidivism "$INSTALL_PATH" "$ATTACK_HOST" \
							"${BAN_PERMANENT_WINDOW:-86400}" "$UTIME" "${BAN_PERMANENT_AFTER:-0}"; then
							ban_expiry=0
							eout "{$MOD} $ATTACK_HOST escalated to permanent ban (repeat offender)." le
						else
							ban_expiry=$((UTIME + BAN_DURATION))
						fi
						state_bans_active_append "$INSTALL_PATH" "$UTIME" "$ban_expiry" "$ATTACK_HOST" "$MOD" "${PORTS:-all}"
						local ban_action="ban"
						if [ "$ban_expiry" -eq 0 ] && [ "${BAN_DURATION:-0}" -gt 0 ]; then
							ban_action="escalate"
						fi
						state_bans_history_append "$INSTALL_PATH" "$UTIME" "$ban_expiry" "$ATTACK_HOST" "$MOD" "$ban_action"
					fi
				fi
			fi
		done < <(echo "$HOSTS_PARSED" | uniq)
	done
}

_apool_report() {
	local source_file="$1"
	local title="$2"
	local search="${3:-}"
	local atmp
	atmp=$(mktemp "$INSTALL_PATH/tmp/.alist.XXXXXX")
	echo "[+] $title" && echo
	echo "#TRIGS|IP|FIRST_SEEN|LAST_SEEN|RULES" > "$atmp"
	local cnt aip first_ts last_ts mods first_fmt last_fmt
	while IFS='|' read -r cnt aip first_ts last_ts mods; do
		[ -z "$cnt" ] && continue
		first_fmt=$(date -d "@${first_ts}" +"%D %H:%M:%S")
		last_fmt=$(date -d "@${last_ts}" +"%D %H:%M:%S")
		echo "$cnt|$aip|$first_fmt|$last_fmt|$mods" >> "$atmp"
	done < <(
		if [ -n "$search" ]; then
			grep -E "$search" "$source_file"
		else
			cat "$source_file"
		fi | awk '{
			ip = $2; ts = $1 + 0; rule = $3
			count[ip]++
			if (!(ip in first) || ts < first[ip]) first[ip] = ts
			if (!(ip in last) || ts > last[ip]) last[ip] = ts
			if (rules[ip] == "") rules[ip] = rule
			else if (index(rules[ip], rule) == 0) rules[ip] = rules[ip] "," rule
		}
		END {
			for (ip in count)
				print count[ip] "|" ip "|" first[ip] "|" last[ip] "|" rules[ip]
		}' | sort -t'|' -k1 -nr | head -n 25
	)
	format_table < "$atmp"
	rm -f "$atmp"
}

apool_list() {
	local ahost="${1:-}"
	if [ -n "$ahost" ]; then
		local WAPOOL_LIST
		WAPOOL_LIST=$(mktemp "$INSTALL_PATH/tmp/.weekly.apool.XXXXXX")
		find "$APOOL_LIST"* -type f -mtime -7 -exec cat {} + > "$WAPOOL_LIST" 2>/dev/null
		_apool_report "$WAPOOL_LIST" "Events for search string \"$ahost\"" "$ahost"
		rm -f "$WAPOOL_LIST"
	elif [ -f "$APOOL_LIST" ]; then
		_apool_report "$APOOL_LIST" "Top 25 brute force attackers today"
		echo
		local WAPOOL_LIST
		WAPOOL_LIST=$(mktemp "$INSTALL_PATH/tmp/.weekly.apool.XXXXXX")
		find "$APOOL_LIST"* -type f -mtime -7 -exec cat {} + > "$WAPOOL_LIST" 2>/dev/null
		_apool_report "$WAPOOL_LIST" "Top 25 brute force attackers this week"
		rm -f "$WAPOOL_LIST"
	fi
}

run() {
	pre
	get_state
	process_unbans "$INSTALL_PATH" "$UTIME" "$UNBAN_COMMAND_TEMPLATE"
	check
}

usage() {
	echo "usage: $0 [OPTION]"
	echo "-s|--standard .............. run standard with output"
	echo "-q|--quiet ................. run quiet with output hidden"
	echo "-d|--dryrun ................ run detection without banning"
	echo "-a|--attackpool [STRING] ... list addresses that have attacked this host"
	echo "-v|--version ............... display version"
	echo "-h|--help .................. display this help"
}

case "$1" in
-s|--standard)  vhead; run ;;
-q|--quiet)     exec >/dev/null 2>&1; run ;;
-d|--dryrun)    DRY_RUN=1; vhead; run ;;
-a|--attackpool) vhead; pre; apool_list "${2:-}" ;;
-v|--version)   vhead ;;
-h|--help|*)    vhead; usage ;;
esac
exit $EXIT_OK
