# Pre-process global modifier flags (--json, --csv, --verbose, --max-lines=, --scan-timeout=,
# --sort=, --24h, --7d, --30d, --limit=, --active)
VERBOSE=0
OUTPUT_FORMAT="table"
_CLI_SCAN_MAX_LINES=""
_CLI_SCAN_TIMEOUT=""
_EVENTS_SORT="count"
_EVENTS_WINDOW="24h"
_EVENTS_LIMIT="100"
_RULES_ACTIVE_ONLY=0
declare -a _bfd_args=()
# shellcheck disable=SC2034
for _arg in "$@"; do
	case "$_arg" in
		--json) OUTPUT_FORMAT="json" ;;
		--csv)  OUTPUT_FORMAT="csv" ;;
		--verbose|-V) VERBOSE=1; ELOG_VERBOSE=1 ;;
		--max-lines=*) _CLI_SCAN_MAX_LINES="${_arg#--max-lines=}" ;;
		--scan-timeout=*) _CLI_SCAN_TIMEOUT="${_arg#--scan-timeout=}" ;;
		--sort=*) _EVENTS_SORT="${_arg#--sort=}" ;;
		--limit=*) _EVENTS_LIMIT="${_arg#--limit=}" ;;
		--24h) _EVENTS_WINDOW="24h" ;;
		--7d)  _EVENTS_WINDOW="7d" ;;
		--30d) _EVENTS_WINDOW="30d" ;;
		--active) _RULES_ACTIVE_ONLY=1 ;;
		*)      _bfd_args+=("$_arg") ;;
	esac
done
set -- "${_bfd_args[@]+"${_bfd_args[@]}"}"
# Validate --sort= value
case "$_EVENTS_SORT" in
	count|time|ip) ;;
	*) echo "warning: unknown sort mode '$_EVENTS_SORT', using 'count'" >&2
	   _EVENTS_SORT="count" ;;
esac
# Validate --limit= value (must be non-negative integer)
case "$_EVENTS_LIMIT" in
	''|*[!0-9]*) echo "warning: invalid limit '$_EVENTS_LIMIT', using '100'" >&2
	   _EVENTS_LIMIT="100" ;;
esac
# Compute _EVENTS_CUTOFF from window selection
case "$_EVENTS_WINDOW" in
	7d)  _EVENTS_CUTOFF=$(( $(date +%s) - 604800 )) ;;
	30d) _EVENTS_CUTOFF=$(( $(date +%s) - 2592000 )) ;;
	*)   _EVENTS_CUTOFF=$(( $(date +%s) - 86400 )) ;;
esac

case "${1:-}" in
-s|--standard)  vhead; bfd_run ;;
-q|--quiet)     exec >/dev/null; bfd_run ;;
-d|--dryrun)    DRY_RUN=1; vhead; bfd_run ;;
-w|--watch)     vhead; watch ;;
-a|--attackpool|--activity)
	[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
	if [ -n "${2:-}" ] && validate_ip_any "$2" >/dev/null 2>&1; then
		case "$OUTPUT_FORMAT" in
			json) search_ip_json "$INSTALL_PATH" "$2" ;;
			csv)  search_ip_csv "$INSTALL_PATH" "$2" ;;
			*)    search_ip "$INSTALL_PATH" "$2" ;;
		esac
	else
		case "$OUTPUT_FORMAT" in
			json) apool_list_json "${2:-}" ;;
			csv)  apool_list_csv "${2:-}" ;;
			*)    apool_list "${2:-}" ;;
		esac
	fi
	;;
-e|--events)
	[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
	if [ -n "${2:-}" ] && validate_ip_any "$2" >/dev/null 2>&1; then
		case "$OUTPUT_FORMAT" in
			json) events_list_ip_json "$INSTALL_PATH" "$2" "${3:-}" ;;
			csv)  events_list_ip_csv "$INSTALL_PATH" "$2" ;;
			*)    events_list_ip "$INSTALL_PATH" "$2" "${3:-}" ;;
		esac
	elif [ -n "${2:-}" ] && [[ "$2" == */* ]]; then
		case "$OUTPUT_FORMAT" in
			json) events_list_cidr_json "$INSTALL_PATH" "$2" "$_EVENTS_SORT" "$_EVENTS_LIMIT" || exit "$?" ;;
			csv)  events_list_cidr_csv "$INSTALL_PATH" "$2" "$_EVENTS_SORT" "$_EVENTS_LIMIT" || exit "$?" ;;
			*)    events_list_cidr "$INSTALL_PATH" "$2" "$_EVENTS_SORT" "$_EVENTS_LIMIT" || exit "$?" ;;
		esac
	else
		case "$OUTPUT_FORMAT" in
			json) events_list_json "$INSTALL_PATH" "$_EVENTS_SORT" "$_EVENTS_LIMIT" ;;
			csv)  events_list_csv "$INSTALL_PATH" "$_EVENTS_SORT" "$_EVENTS_LIMIT" ;;
			*)    events_list "$INSTALL_PATH" "$_EVENTS_SORT" "$_EVENTS_LIMIT" ;;
		esac
	fi
	;;
-c|--check)     vhead; pre; health_check "$INSTALL_PATH" ;;
-l|--list)
	[ "$OUTPUT_FORMAT" = "table" ] && vhead; pre
	case "$OUTPUT_FORMAT" in
		json) list_bans_json "$INSTALL_PATH" ;;
		csv)  list_bans_csv "$INSTALL_PATH" ;;
		*)    list_bans "$INSTALL_PATH" ;;
	esac
	;;
-u|--unban)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -u requires an IP address." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	manual_unban "$INSTALL_PATH" "$2" "$UTIME" || exit "$?"
	;;
-b|--ban)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -b requires an IP address." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	if [ -n "${3:-}" ] && [[ "${3}" == -* ]]; then
		echo "error: service name cannot start with '-': '${3}'" >&2
		echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	manual_ban "$INSTALL_PATH" "$2" "$UTIME" "${3:-manual}" "all" || exit "$?"
	;;
-S|--status)
	vhead; pre
	if [ -n "${2:-}" ]; then
		show_service_status "$INSTALL_PATH" "$2" || exit "$?"
	else
		show_status "$INSTALL_PATH" || exit "$?"
	fi
	;;
-C|--config)    show_config "${2:-}" || exit "$?" ;;
-R|--rules)
	vhead; pre
	if [ -n "${2:-}" ]; then
		show_rule "$INSTALL_PATH" "$2" || exit "$?"
	else
		list_rules "$INSTALL_PATH" "$_RULES_ACTIVE_ONLY" || exit "$?"
	fi
	;;
-T|--test)
	vhead; pre
	if [ -z "${2:-}" ]; then
		echo "error: -T requires a rule name." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	test_rule "$INSTALL_PATH" "$2" "${3:-}" || exit "$?"
	;;
--test-pattern)
	vhead
	if [ -z "${2:-}" ]; then
		echo "error: --test-pattern requires a pattern." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	test_pattern "$2" "${3:-}" || exit "$?"
	;;
--test-alert)
	vhead; pre
	test_alert "$INSTALL_PATH" "${2:-}" || exit "$?"
	;;
--scan)
	vhead; pre
	# apply defaults: CLI --max-lines= / --scan-timeout= override config > hardcoded
	if [ -n "$_CLI_SCAN_MAX_LINES" ]; then
		SCAN_MAX_LINES="$_CLI_SCAN_MAX_LINES"
	else
		SCAN_MAX_LINES="${SCAN_MAX_LINES:-50000}"
	fi
	if [ -n "$_CLI_SCAN_TIMEOUT" ]; then
		SCAN_TIMEOUT="$_CLI_SCAN_TIMEOUT"
	else
		SCAN_TIMEOUT="${SCAN_TIMEOUT:-120}"
	fi
	# validate limits
	_int_p='^[0-9]+$'
	if ! [[ "$SCAN_MAX_LINES" =~ $_int_p ]]; then
		echo "error: --max-lines must be a non-negative integer (got '$SCAN_MAX_LINES')." >&2
		exit "$EXIT_CONFIG_ERROR"
	fi
	if ! [[ "$SCAN_TIMEOUT" =~ $_int_p ]] || [ "$SCAN_TIMEOUT" -eq 0 ]; then
		echo "error: --scan-timeout must be a positive integer (got '$SCAN_TIMEOUT')." >&2
		exit "$EXIT_CONFIG_ERROR"
	fi
	# parse sub-args: optional RULE and -d/--dryrun (order-independent)
	_SCAN_RULE=""
	_s2="${2:-}"; _s3="${3:-}"
	case "$_s2" in
		-d|--dryrun) DRY_RUN=1 ;;
		"") ;;
		-*) echo "error: unknown scan option '$_s2'" >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR" ;;
		*)  _SCAN_RULE="$_s2" ;;
	esac
	case "$_s3" in
		-d|--dryrun) DRY_RUN=1 ;;
		"") ;;
		-*) echo "error: unknown scan option '$_s3'" >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR" ;;
		*)  [ -z "$_SCAN_RULE" ] && _SCAN_RULE="$_s3" ;;
	esac
	if [ -n "$_SCAN_RULE" ] && [ ! -f "$RULES_PATH/$_SCAN_RULE" ]; then
		echo "error: rule '$_SCAN_RULE' not found." >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR"
	fi
	get_state
	_SCAN_MODE=1
	_SCAN_LOG_PAIRS=""
	eout "scan: processing ${_SCAN_RULE:-all rules} (max_lines=$SCAN_MAX_LINES, timeout=${SCAN_TIMEOUT}s, dry_run=$DRY_RUN)" le
	# watchdog: kill the entire process group if scan exceeds SCAN_TIMEOUT seconds.
	# kill -TERM -- -$$ targets the process group, ensuring child processes inside
	# $() command substitutions are terminated so the trap handler fires immediately.
	( sleep "$SCAN_TIMEOUT"; kill -TERM -- -$$ ) >/dev/null 2>&1 &
	_scan_watchdog_pid=$!
	trap 'kill "$_scan_watchdog_pid" 2>/dev/null; wait 2>/dev/null; eout "scan: timed out after ${SCAN_TIMEOUT}s -- use --scan-timeout=N to extend" le; exit 1' TERM
	process_unbans "$INSTALL_PATH" "$UTIME"
	check
	kill "$_scan_watchdog_pid" 2>/dev/null
	trap cleanup TERM
	# force-flush digest spool after scan (one-shot operation)
	if [ "${EMAIL_ALERTS:-0}" = "1" ] && [ "${EMAIL_DIGEST:-cycle}" = "timed" ]; then
		_bfd_digest_flush
	fi
	_SCAN_MODE=""
	if [ "$DRY_RUN" != "1" ] && [ -n "$_SCAN_LOG_PAIRS" ]; then
		_deduped_pairs=$(printf '%s\n' "$_SCAN_LOG_PAIRS" | sort -u)
		tlog_advance_cursors "${TLOG_BASERUN:-$INSTALL_PATH/tmp}" "$_deduped_pairs"
		unset _deduped_pairs
		eout "scan: cursors advanced to current position" le
	elif [ "$DRY_RUN" = "1" ]; then
		vout "scan: dry-run — cursors not advanced"
	fi
	;;
--report)
	vhead; pre
	report "${2:-daily}" || exit "$?"
	;;
--flush-temp)   vhead; pre; flush_bans "$INSTALL_PATH" "temp" "$UTIME" || exit "$?" ;;
--flush-all)    vhead; pre; flush_bans "$INSTALL_PATH" "all" "$UTIME" || exit "$?" ;;
-v|--version)   vhead ;;
-h|--help)      vhead; usage ;;
"")             vhead; usage_short ;;
*)              vhead; echo "error: unknown option '$1'" >&2; echo >&2; usage >&2; exit "$EXIT_CONFIG_ERROR" ;;
esac
exit "$EXIT_OK"
