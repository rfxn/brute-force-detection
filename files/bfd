INSTALL_PATH="/usr/local/bfd"
CNF="$INSTALL_PATH/conf.bfd"
INTCNF="$INSTALL_PATH/internals/internals.conf"
V="2.0.1"
# shellcheck disable=SC2034 # APPN used by importconf
APPN="BFD"
UTIME=$(date +"%s")

# inline: _check_file_safety unavailable before bfd.lib.sh is sourced
_lib_owner=$(stat -L -c '%u' "$INSTALL_PATH/internals/bfd.lib.sh")
_lib_perms=$(stat -L -c '%a' "$INSTALL_PATH/internals/bfd.lib.sh")
_lib_group="${_lib_perms:1:1}"
_lib_world="${_lib_perms: -1}"
if [ "$_lib_owner" != "0" ] || [ "$((_lib_group & 2))" -ne 0 ] || [ "$((_lib_world & 2))" -ne 0 ]; then
	echo "bfd.lib.sh has unsafe ownership (uid=$_lib_owner) or group/world-writable permissions ($_lib_perms), aborting."
	exit 1
fi
# shellcheck source=files/internals/bfd.lib.sh
. "$INSTALL_PATH/internals/bfd.lib.sh"

# initialize variables that may be unset
SKIP_ALERT=""
DRY_RUN=0
_COUNTRY_CACHE_FILE=""
_IGNORE_CACHE_FILE=""

# ELOG constants (BFD-specific, never change on reload)
# shellcheck disable=SC2034
ELOG_APP="bfd"
# shellcheck disable=SC2034
ELOG_TS_FORMAT="%b %e %H:%M:%S"
# shellcheck disable=SC2034
ELOG_STDOUT="always"
# shellcheck disable=SC2034
ELOG_STDOUT_PREFIX="full"

# Associative arrays — must be at global scope (declare -A inside functions
# creates locals in bash 4.1, breaking the pressure model)
declare -A _PRESS_WEIGHT _PRESS_TRIP _PRESS_SKIP_ALERT _PRESS_RULE_EMAIL
declare -A _THRESH_TRIG _THRESH_SKIP_ALERT _THRESH_RULE_EMAIL

_cleanup_common() {
	rm -rf "$LOCK_FILE.lk" 2>/dev/null
	rm -f "$LOCK_FILE" 2>/dev/null
	rm -f "${_COUNTRY_CACHE_FILE:-}" "${_IGNORE_CACHE_FILE:-}" 2>/dev/null
}

# shellcheck disable=SC2317 # called via trap
cleanup() {
	_cleanup_common
}
trap cleanup EXIT INT TERM

