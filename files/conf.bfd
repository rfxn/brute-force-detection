#
# NOTE: This file should be edited with word/line wrapping off,
#       if your using pico please start it with the -w switch.
#       (e.g: pico -w filename)
#

# how many failure events must an address have before being blocked?
# you can override this on a per rule basis in /usr/local/bfd/rules/
TRIG="15"

# sliding window in seconds for counting failures (default 5 min)
# only failures within this window count toward the trigger threshold
TRIG_WINDOW="300"

# cross-service aggregate threshold (0 = disabled)
# when enabled, failures from ALL services count toward this threshold
# regardless of per-rule TRIG values
TRIG_GLOBAL="0"

# ban duration in seconds (0 = permanent, 300 = 5 minutes)
# temporary bans are automatically removed after this duration
# requires UNBAN_COMMAND to be set for auto-unban to work
BAN_DURATION="300"

# number of temporary bans before permanent ban (0 = disabled)
# when an IP is temp-banned this many times within BAN_PERMANENT_WINDOW,
# subsequent bans are escalated to permanent
BAN_PERMANENT_AFTER="5"

# window in seconds for counting repeat offenses (default 24 hours)
# only bans within this window count toward BAN_PERMANENT_AFTER threshold
BAN_PERMANENT_WINDOW="86400"

# send email alerts for all events [0 = off; 1 = on]
EMAIL_ALERTS="0" 

# local user or email address alerts are sent to (separate multiple with comma)
EMAIL_ADDRESS="root"

# subject of email alerts
EMAIL_SUBJECT="Brute Force Warning for $HOSTNAME"

# executable command to block attacking hosts
# APF (default):
BAN_COMMAND="/etc/apf/apf -d $ATTACK_HOST {bfd.$MOD}"
# iptables (CentOS 6/7, Ubuntu 14-20):
#BAN_COMMAND="/sbin/iptables -I INPUT -s $ATTACK_HOST -j DROP"
# firewalld (Rocky 8+, CentOS 7):
#BAN_COMMAND="/usr/bin/firewall-cmd --permanent --add-rich-rule='rule family=ipv4 source address=$ATTACK_HOST drop'"
# nftables (Rocky 9+, Debian 12, Ubuntu 22+):
#BAN_COMMAND="/usr/sbin/nft add rule inet filter input ip saddr $ATTACK_HOST drop"
# ip route null-route (all distros):
#BAN_COMMAND="/sbin/ip route add blackhole $ATTACK_HOST/32"
# iptables with port-specific blocking ($PORTS from rule file):
#BAN_COMMAND="/sbin/iptables -I INPUT -s $ATTACK_HOST -p tcp -m multiport --dports $PORTS -j DROP"
# nftables with port-specific blocking:
#BAN_COMMAND="/usr/sbin/nft add rule inet filter input ip saddr $ATTACK_HOST tcp dport { $PORTS } drop"

# command to remove a ban (leave empty to disable auto-unban)
# uses same $ATTACK_HOST, $MOD, and $PORTS variables as BAN_COMMAND
UNBAN_COMMAND=""
# APF:
#UNBAN_COMMAND="/etc/apf/apf -u $ATTACK_HOST"
# iptables:
#UNBAN_COMMAND="/sbin/iptables -D INPUT -s $ATTACK_HOST -j DROP"
# firewalld:
#UNBAN_COMMAND="/usr/bin/firewall-cmd --permanent --remove-rich-rule='rule family=ipv4 source address=$ATTACK_HOST drop'"
# nftables (requires handle lookup):
#UNBAN_COMMAND="/usr/sbin/nft delete rule inet filter input handle $(/usr/sbin/nft -a list chain inet filter input | grep $ATTACK_HOST | awk '{print $NF}')"
# ip route:
#UNBAN_COMMAND="/sbin/ip route del blackhole $ATTACK_HOST/32"
# iptables with port-specific unblocking:
#UNBAN_COMMAND="/sbin/iptables -D INPUT -s $ATTACK_HOST -p tcp -m multiport --dports $PORTS -j DROP"

# IPv6 ban command (leave empty to use BAN_COMMAND for both IPv4 and IPv6)
# when empty, BAN_COMMAND is used for all addresses — works with tools that
# handle both protocols (nft with inet family, APF, ip route)
BAN_COMMAND_V6=""
# ip6tables:
#BAN_COMMAND_V6="/sbin/ip6tables -I INPUT -s $ATTACK_HOST -j DROP"
# nftables (inet family handles both, but use ip6 for v6-only):
#BAN_COMMAND_V6="/usr/sbin/nft add rule inet filter input ip6 saddr $ATTACK_HOST drop"
# ip route null-route:
#BAN_COMMAND_V6="/sbin/ip route add blackhole $ATTACK_HOST/128"

# IPv6 unban command (leave empty to use UNBAN_COMMAND for both)
UNBAN_COMMAND_V6=""
# ip6tables:
#UNBAN_COMMAND_V6="/sbin/ip6tables -D INPUT -s $ATTACK_HOST -j DROP"
# ip route:
#UNBAN_COMMAND_V6="/sbin/ip route del blackhole $ATTACK_HOST/128"

######
# You should not need to edit any options below this line
######

# installation path
INSTALL_PATH="/usr/local/bfd"

# rule files path
RULES_PATH="$INSTALL_PATH/rules"

# track log script path
TLOG_PATH="$INSTALL_PATH/tlog"

# log source mode: auto, file, or journal
# auto (default): use flat log files when available, fall back to journalctl
# file: flat log files only (original behavior, required for CentOS 6)
# journal: prefer journalctl for syslog-based rules (app-log rules still use files)
LOG_SOURCE="auto"

# syslog kernel log path
KERNEL_LOG_PATH="/var/log/messages"

# syslog auth log path
AUTH_LOG_PATH="/var/log/secure"

# syslog mail log path
MAIL_LOG_PATH="/var/log/maillog"

# bfd application log path
BFD_LOG_PATH="/var/log/bfd_log"

# number of log lines to include in email alerts
EMAIL_LOGLINES="50"

# log all events to syslog [0 = off; 1 = on]
OUTPUT_SYSLOG="1"

# log file path for syslog logging
OUTPUT_SYSLOG_FILE="$KERNEL_LOG_PATH"

# template of the email message body
EMAIL_TEMPLATE="$INSTALL_PATH/alert.bfd"

# contains list of files to search for addresses that are excluded from bans
IGNORE_HOST_FILES="$INSTALL_PATH/exclude.files"

# grab the local time zone
TIME_ZONE=$(date +"%z")

# grab the local unix time
TIME_UNIX=$(date +"%s")

# lock file path
LOCK_FILE="$INSTALL_PATH/lock.utime"

# lock file timeout
LOCK_FILE_TIMEOUT="300"
