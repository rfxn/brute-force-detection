# =============================================
# Pressure Model (Detection)
# =============================================
#
# BFD uses exponential-decay pressure scoring: each failed login adds
# pressure weighted by service severity, and pressure decays over time
# via a half-life. A ban fires when accumulated pressure crosses a trip
# point. This naturally differentiates a human typing a wrong password
# from a bot hammering a service.
#
# Pressure formula:
#   pressure = SUM { weight * 2^(-(now - event_time) / half_life) }
#
# Example (SSH, weight=3, trip=15, half-life=300s):
#   Bot: 7 failures in 1s  -> pressure = 3*7 = 21.0 -> BAN
#   Human: 5 typos over 4m -> pressure decays to ~11.1 -> NO BAN

# pressure trip point — accumulated pressure needed to trigger a ban
# per-rule overrides: edit rules/ files or pressure.conf; must be > 0
PRESSURE_TRIP="20"

# pressure half-life in seconds (how fast pressure decays)
# at 1 half-life, pressure is halved; at 2, quartered; etc.
# shorter = more forgiving; longer = longer memory (default 5 minutes)
PRESSURE_HALF_LIFE="300"

# =============================================
# Email Alerts
# =============================================

# send email alerts when hosts are banned [0 = off, 1 = on]
EMAIL_ALERTS="0"

# alert recipient; comma-separated for multiple addresses
EMAIL_ADDRESS="root"

# alert subject line ($HOSTNAME expands at runtime)
EMAIL_SUBJECT="Brute Force Warning for $HOSTNAME"

# log lines from the offending service included in each alert; must be > 0
EMAIL_LOGLINES="50"

# email body format [text = plain text, html = HTML only, both = multipart text+HTML]
# text uses 'mail' command; html/both require 'sendmail' (falls back to text if missing)
EMAIL_FORMAT="text"

# email digest mode [cycle = one email per run, timed = accumulate and send on interval]
EMAIL_DIGEST="cycle"

# digest flush interval in seconds (only used when EMAIL_DIGEST="timed")
EMAIL_DIGEST_INTERVAL="900"

# IP reputation lookup links included in alerts (comma-separated)
# available: abuseipdb, shodan, virustotal, ipinfo, greynoise
EMAIL_REPUTATION_LINKS=""

# --- SMTP Relay (optional — leave empty to use local MTA) ---
# SMTP relay server URL (e.g., smtps://smtp.gmail.com:465, smtp://relay.example.com:587)
SMTP_RELAY=""
# sender address for relay mode (required when SMTP_RELAY is set)
SMTP_FROM=""
# SMTP authentication credentials (required when SMTP_RELAY is set)
SMTP_USER=""
SMTP_PASS=""

# =============================================
# Banning
# =============================================

# firewall backend for ban/unban operations
# auto       - auto-detect: APF > CSF > firewalld > UFW > nftables > iptables > route
# <backend>  - use a specific backend (apf, csf, firewalld, ufw, nftables, iptables, route)
# custom     - use BAN_COMMAND/UNBAN_COMMAND templates (see next section)
FIREWALL="auto"

# how long bans last in seconds; 0 = permanent (default 10 minutes)
# temporary bans auto-expire and the firewall rule is removed
BAN_TTL="600"

# --- Repeat offender handling ---
#
# These four settings work as a pipeline for repeat offenders:
#   1. BAN_ESCALATION controls how ban duration grows each time
#   2. BAN_ESCALATION_CAP puts a ceiling on that growth
#   3. BAN_ESCALATE_AFTER flips to permanent once the count is reached
#   4. BAN_ESCALATE_WINDOW is the lookback window for all of the above
#
# Examples (with BAN_TTL="600"):
#   Fixed 10m bans, permanent after 5th:
#     BAN_ESCALATION="none"   BAN_ESCALATE_AFTER="5"
#     -> 10m, 10m, 10m, 10m, 10m -> permanent
#
#   Doubling bans, permanent after 5th:
#     BAN_ESCALATION="double" BAN_ESCALATE_AFTER="5"
#     -> 10m, 20m, 40m, 80m, 160m -> permanent
#
#   Linear growth, capped at 1h, never permanent:
#     BAN_ESCALATION="linear" BAN_ESCALATION_CAP="3600" BAN_ESCALATE_AFTER="0"
#     -> 10m, 20m, 30m, ... 1h, 1h, 1h (always temporary)

# how ban duration grows for repeat offenders
# none    - same duration every time (default)
# linear  - duration * ban_count (10m, 20m, 30m, ...)
# double  - duration doubles each time (10m, 20m, 40m, 80m, ...)
BAN_ESCALATION="none"

# maximum escalated ban duration in seconds; 0 = no cap (default 24 hours)
BAN_ESCALATION_CAP="86400"

# temporary bans before flipping to permanent; 0 = never go permanent
BAN_ESCALATE_AFTER="5"

# lookback window in seconds for counting repeat offenses (default 24 hours)
BAN_ESCALATE_WINDOW="86400"

# =============================================
# Custom Firewall Commands
# =============================================

# --- Only used when FIREWALL="custom" — skip if using auto or a named backend ---
# $ATTACK_HOST = offending IP, $MOD = service name, $PORTS = rule ports

# command to deny an attacking host
BAN_COMMAND="/etc/apf/apf -d $ATTACK_HOST {bfd.$MOD}"
#BAN_COMMAND="/sbin/iptables -I INPUT -s $ATTACK_HOST -j DROP"
#BAN_COMMAND="/sbin/ip route add blackhole $ATTACK_HOST/32"
#BAN_COMMAND="/sbin/iptables -I INPUT -s $ATTACK_HOST -p tcp -m multiport --dports $PORTS -j DROP"

# command to remove a ban; required for temporary ban auto-expiry
UNBAN_COMMAND="/etc/apf/apf -u $ATTACK_HOST"
#UNBAN_COMMAND="/sbin/iptables -D INPUT -s $ATTACK_HOST -j DROP"
#UNBAN_COMMAND="/sbin/ip route del blackhole $ATTACK_HOST/32"

# IPv6-specific commands; leave empty to use BAN_COMMAND for both protocols
BAN_COMMAND_V6=""
UNBAN_COMMAND_V6=""

# =============================================
# Log Paths
# =============================================

# authentication log (auto-detected: /var/log/auth.log on Debian/Ubuntu)
AUTH_LOG_PATH="/var/log/secure"

# system/kernel log (auto-detected: /var/log/syslog on Debian/Ubuntu)
KERNEL_LOG_PATH="/var/log/messages"

# mail log (auto-detected: /var/log/mail.log on Debian/Ubuntu)
MAIL_LOG_PATH="/var/log/maillog"

# BFD's own application log
BFD_LOG_PATH="/var/log/bfd_log"

# log source: auto (file with journal fallback), file (only), journal (only)
# auto-detection tries log files first, falls back to journalctl if missing
#LOG_SOURCE="auto"

# =============================================
# Advanced
# =============================================

# cross-service aggregate pressure trip point (0 = disabled)
# when set, pressure from ALL services counts toward a single threshold
PRESSURE_TRIP_GLOBAL="0"

# distributed attack detection — ban entire subnets when N unique IPs
# from the same subnet attack the same service within the pressure window
# 0 = disabled; typical value: 3-5
SUBNET_TRIG="0"

# subnet masks for distributed detection
SUBNET_MASK="24"          # IPv4: 8-32 (24 = /24 = 256 addresses)
SUBNET_MASK_V6="48"       # IPv6: 16-128, must be multiple of 16

# watch mode polling interval in seconds (bfd --watch); must be > 0
WATCH_INTERVAL="10"

# scan mode defaults (bfd --scan); override with --max-lines= / --scan-timeout=
# max log lines per rule during scan; 0 = unlimited (default 50000)
SCAN_MAX_LINES="50000"

# journal read timeout in seconds per rule during scan; must be > 0 (default 120)
SCAN_TIMEOUT="120"

# echo BFD log messages to syslog [0 = off, 1 = on]
OUTPUT_SYSLOG="1"

# log output format [classic = syslog-style, json = one JSON object per line]
LOG_FORMAT="classic"

# minimum log severity [0 = debug, 1 = info, 2 = warn, 3 = error]
LOG_LEVEL="1"

# stale lock detection threshold in seconds (default 300 = 5 minutes)
# if a lock file is older than this, it is assumed stale and cleared
#LOCK_FILE_TIMEOUT="300"

# ban/unban command retry count with exponential backoff (default 2)
# set to 0 to disable retries (useful for testing)
#BAN_RETRY_COUNT="2"

# =============================================
# Attack Pool (Long-term History)
# =============================================

# how long to retain attack pool entries in days (default 1 year)
# entries older than this are pruned daily; 0 = no age limit (size cap still applies)
APOOL_RETENTION_DAYS="365"

# maximum attack pool entries (safety cap for high-volume servers)
# oldest entries are dropped when this limit is reached; 0 = no limit
APOOL_MAX_LINES="500000"
