# alert.bfd — email alert template for BFD
# This file is sourced by send_alerts(); output goes to mail.
#
# Available variables:
#   ALERT_ENTRIES  — pre-formatted ban details + source logs
#   ALERT_COUNT    — number of bans in this email
#   HOSTNAME       — system hostname
#   TIME_ZONE      — system timezone offset
#
# Single-ban backward compatibility (when ALERT_COUNT=1):
#   ATTACK_HOST, MOD, ATTACK_COUNT, PORTS, LOG_FILE, BAN_COMMAND
#
cat <<EOF
BFD Alert for $HOSTNAME ($(date +"%Y-%m-%d %H:%M:%S") GMT $TIME_ZONE)

$ALERT_ENTRIES
-----------------------------------------------
BFD (Brute Force Detection) 2.0.1 <bfd@rfxn.com>

EOF
