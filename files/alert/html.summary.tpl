<!-- Summary card -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top:8px;border:1px solid #d4d4d8;border-radius:8px;overflow:hidden;">
<!-- Accent top line -->
<tr>
<td style="background-color:#0891b2;height:3px;font-size:0;line-height:0;">&nbsp;</td>
</tr>
<!-- Summary header -->
<tr>
<td style="background-color:#f4f4f5;padding:10px 16px;border-bottom:1px solid #d4d4d8;">
<span style="font-size:11px;font-weight:bold;color:#52525b;text-transform:uppercase;letter-spacing:1px;">Summary</span>
</td>
</tr>
<tr>
<td style="padding:12px 16px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:13px;">
<!-- Total / Unique -->
<tr>
<td style="padding:4px 0;color:#71717a;width:50%;">Total bans</td>
<td style="padding:4px 0;font-weight:bold;color:#09090b;">{{SUMMARY_TOTAL_BANS}}</td>
<td style="padding:4px 0;color:#71717a;width:25%;">Unique IPs</td>
<td style="padding:4px 0;font-weight:bold;color:#09090b;">{{SUMMARY_UNIQUE_IPS}}</td>
</tr>
<!-- Temporary / Escalated -->
<tr>
<td style="padding:4px 0;color:#71717a;">Temporary</td>
<td style="padding:4px 0;color:#0891b2;font-weight:bold;">{{SUMMARY_TEMPORARY}}</td>
<td style="padding:4px 0;color:#71717a;">Escalated</td>
<td style="padding:4px 0;color:#d97706;font-weight:bold;">{{SUMMARY_ESCALATED}}</td>
</tr>
<!-- Permanent / Repeat -->
<tr>
<td style="padding:4px 0;color:#71717a;">Permanent</td>
<td style="padding:4px 0;color:#dc2626;font-weight:bold;">{{SUMMARY_PERMANENT}}</td>
<td style="padding:4px 0;color:#71717a;">Repeat offenders</td>
<td style="padding:4px 0;font-weight:bold;color:#09090b;">{{SUMMARY_REPEAT_OFFENDERS}} ({{SUMMARY_REPEAT_PCT}}%)</td>
</tr>
</table>
<!-- Separator -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0;">
<tr><td style="border-top:1px solid #d4d4d8;font-size:0;height:1px;">&nbsp;</td></tr>
</table>
<!-- Services + Countries -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:13px;">
<tr>
<td style="padding:4px 0;color:#71717a;width:100px;vertical-align:top;">Services</td>
<td style="padding:4px 0;color:#09090b;">{{SUMMARY_SERVICES}}</td>
</tr>
<tr>
<td style="padding:4px 0;color:#71717a;vertical-align:top;">Countries</td>
<td style="padding:4px 0;color:#09090b;">{{SUMMARY_COUNTRIES}}</td>
</tr>
</table>
</td>
</tr>
</table>
