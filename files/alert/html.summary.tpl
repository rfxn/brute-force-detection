<!-- Summary card -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top:8px;border:1px solid #e0e0e0;border-radius:4px;overflow:hidden;">
<!-- Summary header -->
<tr>
<td style="background-color:#37474f;padding:10px 14px;color:#ffffff;font-size:14px;font-weight:bold;">Summary</td>
</tr>
<tr>
<td style="padding:12px 14px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:13px;">
<!-- Total / Unique -->
<tr>
<td style="padding:4px 0;color:#757575;width:50%;">Total bans</td>
<td style="padding:4px 0;font-weight:bold;">{{SUMMARY_TOTAL_BANS}}</td>
<td style="padding:4px 0;color:#757575;width:25%;">Unique IPs</td>
<td style="padding:4px 0;font-weight:bold;">{{SUMMARY_UNIQUE_IPS}}</td>
</tr>
<!-- Temporary / Escalated -->
<tr>
<td style="padding:4px 0;color:#757575;">Temporary</td>
<td style="padding:4px 0;color:#f9a825;font-weight:bold;">{{SUMMARY_TEMPORARY}}</td>
<td style="padding:4px 0;color:#757575;">Escalated</td>
<td style="padding:4px 0;color:#f57c00;font-weight:bold;">{{SUMMARY_ESCALATED}}</td>
</tr>
<!-- Permanent / Repeat -->
<tr>
<td style="padding:4px 0;color:#757575;">Permanent</td>
<td style="padding:4px 0;color:#d32f2f;font-weight:bold;">{{SUMMARY_PERMANENT}}</td>
<td style="padding:4px 0;color:#757575;">Repeat offenders</td>
<td style="padding:4px 0;font-weight:bold;">{{SUMMARY_REPEAT_OFFENDERS}} ({{SUMMARY_REPEAT_PCT}}%)</td>
</tr>
</table>
<!-- Separator -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0;">
<tr><td style="border-top:1px solid #e0e0e0;font-size:0;height:1px;">&nbsp;</td></tr>
</table>
<!-- Services + Countries -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:13px;">
<tr>
<td style="padding:4px 0;color:#757575;width:100px;vertical-align:top;">Services</td>
<td style="padding:4px 0;">{{SUMMARY_SERVICES}}</td>
</tr>
<tr>
<td style="padding:4px 0;color:#757575;vertical-align:top;">Countries</td>
<td style="padding:4px 0;">{{SUMMARY_COUNTRIES}}</td>
</tr>
</table>
</td>
</tr>
</table>
