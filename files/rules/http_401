# failed logins from a single address before ban
# high threshold to avoid false positives from legitimate 401s
TRIG="30"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# detect access log path (Apache then nginx)
if [ -f "/var/log/httpd/access_log" ]; then
	LP="/var/log/httpd/access_log"
elif [ -f "/usr/local/apache/logs/access_log" ]; then
	LP="/usr/local/apache/logs/access_log"
elif [ -f "/var/log/apache2/access.log" ]; then
	LP="/var/log/apache2/access.log"
elif [ -f "/var/log/nginx/access.log" ]; then
	LP="/var/log/nginx/access.log"
fi

# file must exist for rule to be active
REQ="${LP:-}"
if [ -n "$REQ" ] && [ -f "$REQ" ]; then
	PORTS="80,443"
	TLOG_TF="http.401"

	## HTTP 401 Unauthorized in access logs (Apache combined / nginx)
	ARG_VAL=$("$TLOG_PATH" "$LP" "$TLOG_TF" | extract_hosts \
		'<HOST> -.*" 401 ')
fi
