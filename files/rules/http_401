# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# high trip point to avoid false positives from legitimate 401s
# PRESSURE_WEIGHT="1"
# PRESSURE_TRIP="60"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# detect access log path (Apache then nginx)
if [ -f "/var/log/httpd/access_log" ]; then
	LOG_FILE="/var/log/httpd/access_log"
elif [ -f "/usr/local/apache/logs/access_log" ]; then
	LOG_FILE="/usr/local/apache/logs/access_log"
elif [ -f "/var/log/apache2/access.log" ]; then
	LOG_FILE="/var/log/apache2/access.log"
elif [ -f "/var/log/nginx/access.log" ]; then
	LOG_FILE="/var/log/nginx/access.log"
fi

# file must exist for rule to be active
PREREQ="${LOG_FILE:-}"
if [ -n "$PREREQ" ] && [ -f "$PREREQ" ]; then
	PORTS="80,443"
	LOG_TAG="http.401"

	## HTTP 401 Unauthorized in access logs (Apache combined / nginx)
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		'<HOST> -.*" 401 ')
fi
