# per-rule threshold override (uncomment to override thresholds.conf / conf.bfd)
# TRIG="5"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# phpMyAdmin logs to AUTH_LOG_PATH when AuthLog = 'syslog' (common setup)
REQ="$AUTH_LOG_PATH"

if [ -f "$REQ" ]; then
	PORTS="80,443"
	LP="$AUTH_LOG_PATH"
	TLOG_TF="phpmyadmin"

	## PHPMYADMIN (syslog auth)
	ARG_VAL=$(_rule_tlog "$LP" "$TLOG_TF" | extract_hosts \
		"pma auth.*mysql-denied.*from <HOST>" \
		"phpmyadmin.*user denied.*from <HOST>")
fi
