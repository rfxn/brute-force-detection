# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="2"
# PRESSURE_TRIP="10"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
PREREQ="/usr/sbin/ejabberdctl"

if [ -f "$PREREQ" ]; then
	PORTS="5222,5269"

	# detect log file path
	if [ -f "/var/log/ejabberd/ejabberd.log" ]; then
		LOG_FILE="/var/log/ejabberd/ejabberd.log"
	else
		LOG_FILE="$KERNEL_LOG_PATH"
	fi
	LOG_TAG="ejabberd"

	## ejabberd — XMPP client authentication failures
	# Auth methods vary (PLAIN, SCRAM-SHA-1, SCRAM-SHA-256, etc.)
	# IPv4-mapped IPv6 (::ffff:A.B.C.D) stripped by extract_hosts
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"Failed c2s .* authentication .* from <HOST>")
fi
