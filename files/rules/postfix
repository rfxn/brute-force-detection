# failed logins from a single address before ban
# uncomment to override conf.bfd trig value
TRIG="10"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
REQ="/usr/sbin/postfix"

if [ -f "$REQ" ]; then
	PORTS="25,26"
	LP="$MAIL_LOG_PATH"
	TLOG_TF="postfix"

	## Postfix dictionary attacks
	ARG_VAL=$("$TLOG_PATH" "$LP" "$TLOG_TF" | extract_hosts \
		"\[<HOST>\].*SASL.*authentication failed")
fi
