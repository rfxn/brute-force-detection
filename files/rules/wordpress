# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="2"
# PRESSURE_TRIP="10"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
# requires wp-fail2ban plugin (logs to AUTH_LOG_PATH via syslog)
PREREQ="$AUTH_LOG_PATH"

if [ -f "$PREREQ" ]; then
	PORTS="80,443"
	LOG_FILE="$AUTH_LOG_PATH"
	LOG_TAG="wordpress"

	## WordPress authentication failures (via wp-fail2ban plugin)
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"wordpress.*Authentication failure .* from <HOST>" \
		"wordpress.*Blocked authentication attempt .* from <HOST>" \
		"wordpress.*XML-RPC authentication .* from <HOST>")
fi
