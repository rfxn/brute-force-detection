# file must exist for rule to be active
REQ="/usr/sbin/imapd"

if [ -f "$REQ" ]; then
	PORTS="110,143,993,995"
	LP="$KERNEL_LOG_PATH"
	TLOG_TF="rh_imapd"

	## imapd
	ARG_VAL=$("$TLOG_PATH" "$LP" "$TLOG_TF" | extract_hosts \
		"imapd.*Login failed.*\[<HOST>\]")
fi
