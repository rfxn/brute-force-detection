# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="5"
# PRESSURE_TRIP="10"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
PREREQ="/usr/local/psa/admin/bin/panel"
if [ ! -f "$PREREQ" ]; then
	PREREQ="/opt/psa/admin/bin/panel"
fi

if [ -f "$PREREQ" ]; then
	PORTS="8443,8880"
	LOG_FILE="/var/log/plesk/panel.log"
	LOG_TAG="plesk"

	## Plesk panel authentication failures
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"Failed login attempt .* from IP <HOST>")
fi
