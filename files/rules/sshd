# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="3"
# PRESSURE_TRIP="15"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
PREREQ="/usr/sbin/sshd"

if [ -f "$PREREQ" ]; then
	PORTS="22"
	LOG_FILE="$AUTH_LOG_PATH"
	LOG_TAG="sshd"

	## SSHD
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"sshd.*Invalid user .* from <HOST>" \
		"sshd.*Failed password for .* from <HOST>" \
		"sshd.*User .* from <HOST> not allowed" \
		"sshd.*Failed keyboard-interactive.* from <HOST>" \
		"sshd.*Did not receive identification string from <HOST>" \
		"sshd.*refused connect from <HOST>" \
		"sshd.*maximum authentication attempts exceeded.* from <HOST>" \
		"sshd.*pam_unix.*authentication failure.*rhost=<HOST>")
fi
