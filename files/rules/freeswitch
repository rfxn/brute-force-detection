# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="2"
# PRESSURE_TRIP="10"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
# package install: /usr/bin/freeswitch; source build: /usr/local/freeswitch/bin/freeswitch
PREREQ="/usr/bin/freeswitch"
if [ ! -f "$PREREQ" ]; then
	PREREQ="/usr/local/freeswitch/bin/freeswitch"
fi

if [ -f "$PREREQ" ]; then
	PORTS="5060,5061"

	# detect log file path (package vs source build)
	if [ -f "/var/log/freeswitch/freeswitch.log" ]; then
		LOG_FILE="/var/log/freeswitch/freeswitch.log"
	else
		LOG_FILE="/usr/local/freeswitch/log/freeswitch.log"
	fi
	LOG_TAG="freeswitch"

	## FreeSWITCH — SIP authentication failures
	# Requires log-auth-failures enabled on Sofia SIP profiles
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"SIP auth failure.* from ip <HOST>" \
		"Can't find user .* from ip <HOST>")
fi
