# failed logins from a single address before ban
# uncomment to override conf.bfd trig value
TRIG="5"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# file must exist for rule to be active
REQ="/usr/sbin/asterisk"

if [ -f "$REQ" ]; then
	PORTS="5060,5061"
	LP="/var/log/asterisk/full"
	TLOG_TF="asterisk_nopeer"

	## ASTERISK NOPEER
	ARG_VAL=$("$TLOG_PATH" "$LP" "$TLOG_TF" | grep -E 'No matching peer found' | grep -E chan_sip | awk '{NF=NF-5} {print $NF}'| tr -d '\'')
fi
