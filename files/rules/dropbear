# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="3"
# PRESSURE_TRIP="15"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
REQ="/usr/sbin/dropbear"

if [ -f "$REQ" ]; then
	PORTS="22"
	LP="$AUTH_LOG_PATH"
	TLOG_TF="dropbear"

	## Dropbear SSH authentication failures
	ARG_VAL=$(_rule_tlog "$LP" "$TLOG_TF" | extract_hosts \
		"dropbear.*Bad password attempt .* from <HOST>" \
		"dropbear.*Login attempt for nonexistent user from <HOST>")
fi
