# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="5"
# PRESSURE_TRIP="10"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
PREREQ="/usr/local/cpanel/logs/login_log"

if [ -f "$PREREQ" ]; then
	PORTS="2082,2083,2086,2087,2095,2096"
	LOG_FILE="/usr/local/cpanel/logs/login_log"
	LOG_TAG="cpanel"

	## whm, cpanel, webmaild (pre-76 and 76+ log formats)
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"<HOST> -.* FAILED LOGIN" \
		"\] <HOST> -.* FAILED LOGIN")
fi
