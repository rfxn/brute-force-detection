# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="2"
# PRESSURE_TRIP="30"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
PREREQ="/usr/sbin/exim"
if [ ! -f "$PREREQ" ]; then
	PREREQ="/usr/sbin/exim4"
fi

if [ -f "$PREREQ" ]; then
	PORTS="25,26,465"
	LOG_FILE="/var/log/exim_mainlog"
	if [ ! -f "$LOG_FILE" ]; then
		LOG_FILE="/var/log/exim4/mainlog"
	fi
	LOG_TAG="exim_nxuser"

	## EXIM non-existing users
	MATCHED_HOSTS=$(_rule_tlog "$LOG_FILE" "$LOG_TAG" | extract_hosts \
		"\[<HOST>\].*No such person at this address")
fi
