# per-rule threshold override (uncomment to override thresholds.conf / conf.bfd)
# TRIG="5"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
REQ="/usr/local/directadmin/directadmin"

if [ -f "$REQ" ]; then
	PORTS="2222"
	LP="/var/log/directadmin/login.log"
	TLOG_TF="directadmin"

	## DirectAdmin authentication failures
	ARG_VAL=$("$TLOG_PATH" "$LP" "$TLOG_TF" | extract_hosts \
		"'<HOST>' [0-9]+ failed login attempt")
fi
