# per-rule pressure override (uncomment to override pressure.conf / conf.bfd)
# PRESSURE_WEIGHT="2"
# PRESSURE_TRIP="20"

# uncomment to disable alerting for this rule
# SKIP_ALERT="1"

# uncomment to route alerts for this rule to a different address
# RULE_EMAIL=""

# file must exist for rule to be active
REQ="/usr/sbin/dovecot"

if [ -f "$REQ" ]; then
	PORTS="110,143,993,995"
	LP="$MAIL_LOG_PATH"
	TLOG_TF="dovecot"

	## DOVECOT IMAP/POP3
	IGNOREREGEX="no auth attempts"
	ARG_VAL=$(_rule_tlog "$LP" "$TLOG_TF" | extract_hosts \
		"pop3-login.*auth failed.*rip=<HOST>" \
		"imap-login.*auth failed.*rip=<HOST>" \
		"pop3-login.*Disconnected.*rip=<HOST>" \
		"imap-login.*Disconnected.*rip=<HOST>" \
		"submission-login.*auth failed.*rip=<HOST>")
fi
