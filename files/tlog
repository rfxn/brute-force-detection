#
# PATH export: standalone tlog runs as a subprocess with no inherited PATH.
# When rules migrate to in-process _rule_tlog(), this script remains for
# cron.daily and manual invocation where PATH may not be set.
PATH=/sbin:/usr/sbin:/usr/bin:/usr/local/bin:/usr/local/sbin:$PATH ; export PATH


# Base run path; no trailing slash
BASERUN="${BASERUN:-/usr/local/bfd/tmp}"

if [ -z "$1" ] && [ -z "$2" ]; then
	echo "$0 usage: [file] [tlog]"
	echo "file   :   path to file for tracking"
	echo "tlog   :   data file name to store tracked sizes"
	exit 1
else
	FILE="$1"
	TLOG="$2"
fi

# Journal fallback: use journal when file is missing (auto or journal mode)
if [ "${LOG_SOURCE:-auto}" != "file" ] && [ ! -f "$FILE" ]; then
	_LIB="${INSTALL_PATH:-/usr/local/bfd}/bfd.lib.sh"
	if [ -f "$_LIB" ]; then
		_lib_owner=$(stat -L -c '%u' "$_LIB" 2>/dev/null) || _lib_owner=""
		_lib_perms=$(stat -L -c '%a' "$_LIB" 2>/dev/null) || _lib_perms=""
		_lib_world="${_lib_perms: -1}"
		if [ "$_lib_owner" != "0" ] || [ "$((_lib_world & 2))" -ne 0 ]; then
			echo "error: bfd.lib.sh has unsafe ownership or permissions, aborting." >&2
			exit 1
		fi
		# shellcheck disable=SC1090
		. "$_LIB"
		if tlog_journal_read "$TLOG" "$BASERUN" 2>/dev/null; then
			exit 0
		fi
	fi
fi

if [ ! -f "$FILE" ]; then
	echo "$FILE is not a valid file, aborting"
	exit 1
elif [ ! -d "$BASERUN" ]; then
	echo "$BASERUN is not a valid operating path, aborting."
	exit 1
fi

get_file_size() {
	local file="$1"
	stat -c %s "$file" 2>/dev/null || wc -c < "$file"
}

# getsize — read tracked size and current file size into SIZE and NEWSIZE.
# tlog_read() in bfd.lib.sh is the library equivalent; both must stay in sync.
# Future: tlog callers should migrate to tlog_read(); this script remains for
# standalone/cron compatibility.
getsize() {
	local tsize=""
	if [ -f "$BASERUN/$TLOG" ]; then
		read -r tsize < "$BASERUN/$TLOG" 2>/dev/null || tsize=""
	fi
	if [ -z "$tsize" ] || [ "$tsize" = "0" ]; then
		# first run or reset — record current size, no output
		SIZE=$(get_file_size "$FILE")
		echo "$SIZE" > "$BASERUN/$TLOG"
		NEWSIZE="$SIZE"
	else
		SIZE="$tsize"
		NEWSIZE=$(get_file_size "$FILE")
	fi
}

getsize

if [ "$NEWSIZE" -gt "$SIZE" ]; then
	tail -c $((NEWSIZE - SIZE)) "$FILE"
	echo "$NEWSIZE" > "$BASERUN/$TLOG"
elif [ "$NEWSIZE" -lt "$SIZE" ]; then
	# log rotated — output remainder from old (rotated) file
	if [ -f "$FILE.1" ]; then
		RTSIZE=$(get_file_size "$FILE.1")
		if [ "$RTSIZE" -ge "$SIZE" ]; then
			tail -c $((RTSIZE - SIZE)) "$FILE.1"
		fi
	elif [ -f "$FILE.1.gz" ]; then
		RTSIZE=$(zcat "$FILE.1.gz" | wc -c)
		if [ "$RTSIZE" -ge "$SIZE" ]; then
			zcat "$FILE.1.gz" | tail -c $((RTSIZE - SIZE))
		fi
	fi
	# output all of current file (it's new content since rotation)
	if [ "$NEWSIZE" -gt 0 ]; then
		cat "$FILE"
	fi
	echo "$NEWSIZE" > "$BASERUN/$TLOG"
fi
