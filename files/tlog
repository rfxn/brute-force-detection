# Just a global PATH so we can find common binaries
PATH=/sbin:/usr/sbin:/usr/bin:/usr/local/bin:/usr/local/sbin:$PATH ; export PATH


# Base run path; no trailing slash
BASERUN="${BASERUN:-/usr/local/bfd/tmp}"

if [ "$1" = "" ] && [ "$2" = "" ]; then
	echo "$0 usage: [file] [tlog]"
	echo "file   :   path to file for tracking"
	echo "tlog   :   data file name to store tracked sizes"
	exit 1
else
	FILE="$1"
	TLOG="$2"
fi

# Journal fallback: use journal when file is missing (auto or journal mode)
if [ "${LOG_SOURCE:-auto}" != "file" ] && [ ! -f "$FILE" ]; then
	_LIB="${INSTALL_PATH:-/usr/local/bfd}/bfd.lib.sh"
	if [ -f "$_LIB" ]; then
		# shellcheck disable=SC1090
		. "$_LIB"
		if tlog_journal_read "$TLOG" "$BASERUN" 2>/dev/null; then
			exit 0
		fi
	fi
fi

if [ ! -f "$FILE" ]; then
	echo "$FILE is not a valid file, aborting"
	exit 1
elif [ ! -d "$BASERUN" ]; then
	echo "$BASERUN is not a valid operating path, aborting."
	exit 1
fi

get_file_size() {
	local file="$1"
	stat -c %s "$file" 2>/dev/null || wc -c < "$file"
}

if [ ! -f "$BASERUN/$TLOG" ]; then
	echo "0" > "$BASERUN/$TLOG"
fi

TSIZE=$(cat "$BASERUN/$TLOG" 2>/dev/null)

getsize() {
if [ ! -f "$BASERUN/$TLOG" ]; then
	SIZE=$(get_file_size "$FILE")
	echo "$SIZE" > "$BASERUN/$TLOG"
        NEWSIZE=$(get_file_size "$FILE")
elif [ -f "$BASERUN/$TLOG" ] && [ "$TSIZE" = "0" ]; then
        SIZE=$(get_file_size "$FILE")
        echo "$SIZE" > "$BASERUN/$TLOG"
        NEWSIZE=$(get_file_size "$FILE")
else
	SIZE=$(cat "$BASERUN/$TLOG")
	NEWSIZE=$(get_file_size "$FILE")
fi
}

getsize

if [ ! "$NEWSIZE" -lt "$SIZE" ] && [ "$NEWSIZE" -ne "$SIZE" ]; then
	tail -c $((NEWSIZE - SIZE)) "$FILE"
	echo "$NEWSIZE" > "$BASERUN/$TLOG"
elif [ "$NEWSIZE" -lt "$SIZE" ]; then
	# log rotated — output remainder from old (rotated) file
	if [ -f "$FILE.1" ]; then
		RTSIZE=$(get_file_size "$FILE.1")
		if [ "$RTSIZE" -ge "$SIZE" ]; then
			tail -c $((RTSIZE - SIZE)) "$FILE.1"
		fi
	elif [ -f "$FILE.1.gz" ]; then
		RTSIZE=$(zcat "$FILE.1.gz" | wc -c)
		if [ "$RTSIZE" -ge "$SIZE" ]; then
			zcat "$FILE.1.gz" | tail -c $((RTSIZE - SIZE))
		fi
	fi
	# output all of current file (it's new content since rotation)
	if [ "$NEWSIZE" -gt 0 ]; then
		cat "$FILE"
	fi
	echo "$NEWSIZE" > "$BASERUN/$TLOG"
fi
